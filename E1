function Section:MultiDropdown(opts)
	local ui = self.UI
	local options = opts.Options or {}
	local row = self:_row(L.Row, false)
	local label = U.label({ Text = opts.Name, Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -152, 1, 0), Parent = row })
	self:_hook(label, opts.Description)
	local btn = U.button({
		BackgroundColor3 = C.Background, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -4, .5, 0),
		Size = UDim2.fromOffset(144, L.Hit), Parent = row,
	})
	U.corner(btn, 8)
	U.stroke(btn, C.Stroke)
	local valueLabel = U.label({
		Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -32, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn,
	})
	U.chevron(btn, false, C.SubText, UDim2.new(1, -16, .5, 0))

	local function clean(v)
		local out, seen = {}, {}
		if typeof(v) == "table" then
			for _, o in ipairs(options) do
				if table.find(v, o) and not seen[o] then
					seen[o] = true
					out[#out + 1] = o
				end
			end
		end
		return out
	end
	local function setter(v)
		if typeof(v) ~= "table" then return nil end
		v = clean(v)
		if #v == 0 then
			valueLabel.Text = T.None
		elseif #v <= 2 then
			valueLabel.Text = table.concat(v, ", ")
		else
			valueLabel.Text = #v .. " selecionados"
		end
		return v
	end
	local ctl = self:_register("MultiDropdown", opts, row, clean(opts.Default or {}), setter)
	function ctl:SetOptions(list)
		options = list or {}
		self:Set(self.Value, true) -- refiltra a selecao sem disparar callback
	end

	ctl:_conn(btn.Activated, function()
		local h = math.min(math.max(#options, 1) * (L.Hit + 2) + 8, L.PopupMax)
		ui:OpenPopup(btn, math.max(btn.AbsoluteSize.X / U.factor, 144), h, function(frame)
			local sc = U.scroller({ Parent = frame })
			U.pad(sc, 4, 4, 4 + L.ScrollBar, 4)
			U.list(sc, 2)
			local function render()
				for _, c in ipairs(sc:GetChildren()) do
					if c:IsA("TextButton") then c:Destroy() end
				end
				for i, opt in ipairs(options) do
					local sel = table.find(ctl.Value, opt) ~= nil
					local b = U.button({
						BackgroundColor3 = C.Accent, BackgroundTransparency = sel and .8 or 1, Size = UDim2.new(1, 0, 0, L.Hit),
						Text = tostring(opt), TextColor3 = sel and C.Accent or C.Text, TextXAlignment = Enum.TextXAlignment.Left,
						LayoutOrder = i, Parent = sc,
					})
					U.corner(b, 6)
					U.pad(b, 10, 0, 6, 0)
					b.Activated:Connect(function()
						local list = {}
						for _, v in ipairs(ctl.Value) do
							if v ~= opt then list[#list + 1] = v end
						end
						if not sel then list[#list + 1] = opt end
						ctl:Set(list)
						render()
					end)
				end
			end
			render()
		end)
	end)
	return self
end

function Section:Keybind(opts)
	local ui = self.UI
	local row = self:_row(L.Row, false)
	local label = U.label({ Text = opts.Name, Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -112, 1, 0), Parent = row })
	self:_hook(label, opts.Description)
	local btn = U.button({
		BackgroundColor3 = C.Background, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -4, .5, 0),
		Size = UDim2.fromOffset(104, L.Hit), TextSize = L.SmallSize + 1, Parent = row,
	})
	U.corner(btn, 8)
	U.stroke(btn, C.Stroke)
	local function setter(v)
		if typeof(v) == "EnumItem" then v = v.Name end
		if v == nil or v == "" then v = "None" end
		if not validBind(v) then return nil end
		btn.Text = v == "None" and T.None or v
		return v
	end
	-- opts.Callback dispara ao apertar a tecla; opts.OnChanged ao trocar o bind
	local ctl = self:_register("Keybind", { Name = opts.Name, Flag = opts.Flag, Callback = opts.OnChanged }, row, opts.Default, setter)
	ctl.Fire = function()
		if opts.Callback then task.spawn(opts.Callback, ctl.Value) end
	end

	local cleared = false
	btn.InputBegan:Connect(function(input)
		if U.isPress(input) then cleared = false end
	end)
	U.longPress(btn, CONFIG.ClearHold, function()
		cleared = true
		ctl:Set("None")
	end)
	btn.Activated:Connect(function()
		if cleared then
			cleared = false
			return
		end
		btn.Text = T.Press
		btn.TextColor3 = C.Accent
		ui.Capture = function(name)
			ui.Capture = nil
			btn.TextColor3 = C.Text
			ctl:Set(name or ctl.Value) -- nil (cancelou) só restaura o texto
		end
	end)
	return self
end

