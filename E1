-- Pad 2D que emite dois valores (X, Y) por arrasto.
-- opts: { Name, MinX, MaxX, MinY, MaxY, Default: {x, y}, Description?, Callback? }
-- Valor: { x, y }

local function Section_XYPad(self, opts)
	local ui = self.UI
	local minX, maxX = opts.MinX or 0, opts.MaxX or 100
	local minY, maxY = opts.MinY or 0, opts.MaxY or 100
	local default = opts.Default or { minX, minY }
	local dx = math.clamp(tonumber(default[1]) or minX, minX, maxX)
	local dy = math.clamp(tonumber(default[2]) or minY, minY, maxY)

	local row = self:_row(L.Hit + 110, false)
