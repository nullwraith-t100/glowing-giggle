		Size = UDim2.new(1, -118, 0, L.Hit), Parent = row,
	})
	self:_hook(label, opts.Description)

	local pad = U.frame({
		BackgroundColor3 = C.Background, AnchorPoint = Vector2.new(1, .5),
		Position = UDim2.new(1, -4, .5, 0), Size = UDim2.fromOffset(110, L.Hit + 66), Parent = row,
	})
	U.corner(pad, 8)
	U.stroke(pad, C.Stroke)

	local cursor = U.frame({
		BackgroundColor3 = C.Accent, AnchorPoint = Vector2.new(.5, .5),
		Size = UDim2.fromOffset(14, 14), Parent = pad,
	})
	U.corner(cursor, 7)
	U.stroke(cursor, C.White, 2)

	local box = U.box({
		BackgroundColor3 = C.Background, BackgroundTransparency = 0, Font = F.Medium,
		TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(4, L.Hit + 10),
		Size = UDim2.new(1, -8, 0, L.Hit - 4), Parent = row,
	})
	U.corner(box, 8)
	U.stroke(box, C.Stroke)

	local ctl
	local function render()
		local rx = maxX > minX and (ctl.Value[1] - minX) / (maxX - minX) or 0
		local ry = maxY > minY and (ctl.Value[2] - minY) / (maxY - minY) or 0
		cursor.Position = UDim2.fromScale(math.clamp(rx, 0, 1), math.clamp(ry, 0, 1))
		box.Text = string.format("X: %.2f  Y: %.2f", ctl.Value[1], ctl.Value[2])
	end
	local function setter(v)
		if typeof(v) ~= "table" or #v < 2 then return nil end
		local x = math.clamp(tonumber(v[1]) or ctl.Value[1], minX, maxX)
		local y = math.clamp(tonumber(v[2]) or ctl.Value[2], minY, maxY)
		ctl.Value = { x, y }
		ui.Flags[ctl.Flag] = { x, y }
		render()
		return { x, y }
	end

	ctl = self:_register("XYPad", opts, row, { dx, dy }, setter)
	render()

	local page = self.Tab.Page
	local active = false
	U.drag(pad, {
		start = function(input)
			active = true
			page.ScrollingEnabled = false
		end,
		move = function(input)
			if not active then return end
			local p = U.pointer(input)
			local ap, as = pad.AbsolutePosition, pad.AbsoluteSize
			local rx = math.clamp((p.X - ap.X) / as.X, 0, 1)
			local ry = math.clamp((p.Y - ap.Y) / as.Y, 0, 1)
			local x = minX + (maxX - minX) * rx
			local y = minY + (maxY - minY) * ry
			ctl:Set({ x, y })
		end,
		stop = function()
			active = false
			page.ScrollingEnabled = true
		end,
	})

	return self
end

