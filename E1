function Section:Destroy()
	local flags = {}
	for _, e in ipairs(self.UI.Registry) do
		if e.Tab == self then table.insert(flags, e.Id) end
	end
	for _, flag in ipairs(flags) do
		local c = self.UI.Controls[flag]
		if c then c:Destroy() end
	end
	if self.Card then pcall(function() self.Card:Destroy() end) end
end


