-- Grupo de opcoes de selecionar unica com estado visual de radio.
-- opts: { Name, Options: {string}, Default, Description?, Callback? }
-- Valor: string (opcao selecionada)

local function Section_RadioGroup(self, opts)
	local ui = self.UI
	local options = opts.Options or {}
	local row = self:_row(L.Row + (#options - 1) * (L.Row + 4), false)
	local label = U.label({
		Text = opts.Name, Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(0, 110, 1, 0), Parent = row,
	})
	self:_hook(label, opts.Description)

	local holder = U.frame({
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, .5),
		Position = UDim2.new(1, -4, .5, 0), Size = UDim2.new(1, -120, 1, 0), Parent = row,
	})
	U.list(holder, 4)

	local ctl
	local buttons = {}
	local function render()
		for i, b in ipairs(buttons) do
			local sel = options[i] == ctl.Value
			local dot = b:FindFirstChildOfClass("Frame") or b:FindFirstChild("Dot")
			if dot then
				U.tween(dot, A.Fast, { BackgroundTransparency = sel and 0 or 1 })
			end
			U.tween(b, A.Fast, { TextColor3 = sel and C.Accent or C.SubText })
		end
	end
	local function setter(v)
		if not table.find(options, v) then return nil end
		ctl.Value = v
		ui.Flags[ctl.Flag] = v
		render()
		return v
	end

	ctl = self:_register("RadioGroup", opts, row, opts.Default or options[1], setter)
	render()

	for i, opt in ipairs(options) do
		local b = U.button({
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, L.Row),
			Text = tostring(opt), TextColor3 = C.SubText, Font = F.Medium,
			TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
		})
		local dot = U.frame({
			Name = "Dot", BackgroundColor3 = C.Accent, AnchorPoint = Vector2.new(0, .5),
			Position = UDim2.fromOffset(0, .5 * L.Row), Size = UDim2.fromOffset(14, 14), Parent = b,
		})
		U.corner(dot, 7)
		U.stroke(dot, C.Stroke)
		ctl:_conn(b.Activated, function() ctl:Set(opt) end)
		table.insert(buttons, b)
	end

	render()
	return self
end

