local UI = {}
UI.__index = UI
UI.HubModules = {} -- registra modulos do hub DerbyBloom (Fase 4): ui.HubModules.Aimbot(ui, win), etc.
local Window = {}
Window.__index = Window
local Tab = {}
Tab.__index = Tab
local Section = {}
Section.__index = Section

-- ---------- UI (raiz) ----------
function UI.new(opts)
	removeOld()
	local self = setmetatable({}, UI)
	self.Flags, self.Controls, self.Registry, self.AccentFns, self.Conns = {}, {}, {}, {}, {}
	self.IsMobile = UIS.TouchEnabled and not UIS.MouseEnabled
	self.ToggleKey = CONFIG.ToggleKey
	self.Icon = (opts and opts.Icon) or CONFIG.Icon
	self.Visible = true
	self.ToastQueue, self.ToastActive, self.ToastSeq, self.TipToken = {}, 0, 0, 0

	self.Gui = create("ScreenGui", {
		Name = CONFIG.Name, ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 10000,
	})
	-- Canvas + UIScale: um único ponto de escala; filhos usam px base
	self.Canvas = create("Frame", { Name = "Canvas", BackgroundTransparency = 1, BorderSizePixel = 0, Parent = self.Gui })
	self.UIScale = create("UIScale", { Parent = self.Canvas })

	self.Popups = create("Frame", {
		Name = "Popups", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
		ZIndex = 100, Visible = false, Parent = self.Canvas,
	})
	self.Toasts = create("Frame", {
		Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12), Size = UDim2.new(0, L.ToastWidth, 1, -24), ZIndex = 150, Parent = self.Canvas,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Top, Parent = self.Toasts,
	})
	self.Tip = U.frame({
		Name = "Tooltip", BackgroundColor3 = C.Header, AnchorPoint = Vector2.new(.5, 1),
		AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.new(), ZIndex = 300, Visible = false, Parent = self.Canvas,
	})
	U.corner(self.Tip, 8)
	U.stroke(self.Tip, C.Stroke)
	U.pad(self.Tip, 10, 6, 10, 6)
	self.TipLabel = U.label({
		Size = UDim2.new(), AutomaticSize = Enum.AutomaticSize.XY, TextWrapped = true,
		TextSize = L.SmallSize + 1, Parent = self.Tip,
	})
	create("UISizeConstraint", { MaxSize = Vector2.new(220, math.huge), Parent = self.TipLabel })

	self:_conn(UIS.InputBegan, function(input, gp) self:_input(input, gp) end)
	self:_conn(UIS.InputEnded, function(input)
		if U.isPress(input) then U.releaseTick += 1 end
	end)
	self:_conn(workspace:GetPropertyChangedSignal("CurrentCamera"), function()
		self:_hookCamera()
		self:_refresh()
	end)
	self:_hookCamera()
	self:_refresh()
	self:_makeFloat()
	mount(self.Gui)
	return self
end

function UI:_conn(signal, fn)
	table.insert(self.Conns, signal:Connect(fn))
end

function UI:_hookCamera()
	if self.CamConn then self.CamConn:Disconnect() end
	local cam = workspace.CurrentCamera
	if cam then
		self.CamConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() self:_refresh() end)
	end
end

function UI:_refresh()
	local vp = U.viewport()
	local f = U.computeFactor()
	self.UIScale.Scale = f
	self.Canvas.Size = UDim2.fromOffset(vp.X / f, vp.Y / f)
	self:ClosePopup()
	if self.Window then self.Window:_layout() end
	if self.Float then self:_placeFloat(self.FloatPos) end
end

function UI:_bindAccent(fn)
	table.insert(self.AccentFns, fn)
	fn()
end

function UI:SetAccent(color)
	C.Accent = color
	for _, fn in ipairs(self.AccentFns) do fn() end
end

function UI:_uniqueFlag(name)
	name = tostring(name or "Flag")
	local flag, i = name, 1
	while self.Controls[flag] do
		i += 1
		flag = name .. "_" .. i
	end
	return flag
end

function UI:Get(flag)
	return self.Flags[flag]
end

function UI:Set(flag, value, silent)
	local ctl = self.Controls[flag]
	if ctl then ctl:Set(value, silent) end
end

function UI:ResetAll()
	for _, ctl in pairs(self.Controls) do ctl:Reset() end
end

function UI:SetVisible(v)
	self.Visible = v
	if self.Window then self.Window.Root.Visible = v end
	if not v then
		self:ClosePopup()
		self:HideTooltip()
	end
end

function UI:Toggle()
	self:SetVisible(not self.Visible)
end

function UI:Destroy()
	self.Destroyed = true
	for _, c in ipairs(self.Conns) do c:Disconnect() end
	if self.CamConn then self.CamConn:Disconnect() end
	if self.Window then self.Window:Destroy() end
	self.Gui:Destroy()
end

function UI:_input(input, processed)
	if self.Tip.Visible and U.isPress(input) then self:HideTooltip() end
	if self.Capture then
		local cap = self.Capture
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.Escape then
				cap(nil)
			elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
				cap("None")
			else
				cap(input.KeyCode.Name)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
			cap(input.UserInputType.Name)
		elseif U.isPress(input) then
			cap(nil)
		end
		return
	end
	if processed then return end
	if input.KeyCode == self.ToggleKey then
		self:Toggle()
		return
	end
	-- nao dispara keybinds enquanto o jogador digita em um TextBox ou na busca global
	local focused = UIS:GetFocusedTextBox()
	if focused and focused:IsA("TextBox") then return end
	for _, ctl in pairs(self.Controls) do
		if ctl.Kind == "Keybind" and ctl.Value ~= "None"
			and (input.KeyCode.Name == ctl.Value or input.UserInputType.Name == ctl.Value) then
			ctl.Fire()
		end
	end
end

-- botao de abrir/fechar: quadrado arredondado com icone e contorno rosa, arrastavel em X/Y
function UI:_makeFloat()
	local s = L.FloatBtn
	local btn = U.button({
		Name = "Float", BackgroundColor3 = C.Header, Size = UDim2.fromOffset(s, s), ZIndex = 50, Parent = self.Canvas,
	})
	U.corner(btn, 12)
	local stroke = U.stroke(btn, C.Accent, 2)
	self:_bindAccent(function() stroke.Color = C.Accent end)
	if self.Icon and self.Icon ~= "" then
		local ic = create("ImageLabel", {
			BackgroundTransparency = 1, Image = self.Icon, ScaleType = Enum.ScaleType.Fit,
			AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5),
			Size = UDim2.new(1, -10, 1, -10), ZIndex = 51, Parent = btn,
		})
		U.corner(ic, 8)
		self.FloatIcon = ic
	end
	self.Float = btn
	local vp = U.viewport()
	self.FloatPos = Vector2.new(vp.X / U.factor - s - 12, vp.Y / U.factor * .4)
	local startIn, startPos, moved = Vector2.zero, Vector2.zero, false
	U.drag(btn, {
		start = function(input)
			startIn = Vector2.new(input.Position.X, input.Position.Y)
			startPos, moved = self.FloatPos, false
		end,
		move = function(input)
			local d = Vector2.new(input.Position.X, input.Position.Y) - startIn
			if d.Magnitude > 6 then moved = true end
			if moved then self:_placeFloat(startPos + d / U.factor) end
		end,
		stop = function()
			if not moved then self:Toggle() end
		end,
	})
	self:_placeFloat(self.FloatPos)
end

function UI:OpenPopup(anchor, w, h, build)
	self:ClosePopup()
	local f, vp = U.factor, U.viewport()
	self.Popups.Visible = true
	local blocker = U.button({ Name = "Blocker", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = self.Popups })
	blocker.Activated:Connect(function() self:ClosePopup() end)
	local ap, as = anchor.AbsolutePosition, anchor.AbsoluteSize
	local pw, ph = w * f, h * f
	local x = math.clamp(ap.X + as.X - pw, 6, math.max(6, vp.X - pw - 6))
	local below = ap.Y + as.Y + 4
	local y = (below + ph <= vp.Y - 6) and below or math.max(6, ap.Y - ph - 4)
	local frame = U.frame({
		Name = "Popup", BackgroundColor3 = C.Surface, Position = UDim2.fromOffset(x / f, y / f),
		Size = UDim2.fromOffset(w, 0), ClipsDescendants = true, ZIndex = 2, Parent = self.Popups,
	})
	U.corner(frame, L.Corner)
	U.stroke(frame, C.Stroke)
	build(frame)
	U.tween(frame, A.Normal, { Size = UDim2.fromOffset(w, h) })
	self.Popup = frame
	return frame
end

function UI:ClosePopup()
	for _, c in ipairs(self.Popups:GetChildren()) do c:Destroy() end
	self.Popups.Visible = false
	self.Popup = nil
end

function UI:ShowTooltip(text, px)
	local f, vp = U.factor, U.viewport()
	self.TipLabel.Text = text
	local x = math.clamp(px.X, U.scale(120), vp.X - U.scale(120))
	local y = math.max(px.Y - U.scale(18), U.scale(60))
	self.Tip.Position = UDim2.fromOffset(x / f, y / f)
	self.Tip.Visible = true
	self.TipToken += 1
	local my = self.TipToken
	task.delay(CONFIG.Tooltip.Show, function()
		if self.TipToken == my and not self.Destroyed then self.Tip.Visible = false end
	end)
end

function UI:Notify(title, text, kind, duration)
	table.insert(self.ToastQueue, { title = title or "", text = text or "", kind = kind or "info", duration = duration or L.ToastTime })
	self:_pump()
end

function UI:_pump()
	if self.Destroyed then return end
	while self.ToastActive < L.MaxToasts and #self.ToastQueue > 0 do
		self:_showToast(table.remove(self.ToastQueue, 1))
	end
end

function UI:_showToast(t)
	self.ToastActive += 1
	self.ToastSeq += 1
	local color = t.kind == "success" and C.Success or t.kind == "error" and C.Error or C.Accent
	local off = L.ToastWidth + 40
	local wrap = create("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = self.ToastSeq, Parent = self.Toasts,
	})
	local card = U.button({
		BackgroundColor3 = C.Header, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.fromOffset(off, 0), Parent = wrap,
	})
	U.corner(card, L.Corner)
	U.stroke(card, color, 1.5)
	U.pad(card, 12, 8, 12, 8)
	U.list(card, 2)
	U.label({
		Text = t.title, Font = F.Bold, TextColor3 = color, TextWrapped = true, LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = card,
	})
	if t.text ~= "" then
		U.label({
			Text = t.text, TextColor3 = C.SubText, TextSize = L.SmallSize + 1, TextWrapped = true, LayoutOrder = 2,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = card,
		})
	end
	U.tween(card, A.Normal, { Position = UDim2.fromOffset(0, 0) })
	local closed = false
	local function close()
		if closed then return end
		closed = true
		U.tween(card, A.Normal, { Position = UDim2.fromOffset(off, 0) }).Completed:Connect(function()
			wrap:Destroy()
			self.ToastActive -= 1
			self:_pump()
		end)
	end
	card.Activated:Connect(close)
	task.delay(t.duration, close)
end

function UI:SaveConfig(file)
	file = file or CONFIG.ConfigFile
	local data = { _v = 2, _flags = {} }
	for flag, ctl in pairs(self.Controls) do
		local v = ctl.Value
		if typeof(v) == "Color3" then v = { __color = U.toHex(v) } end
		data[flag] = v
	end
	local json = HttpService:JSONEncode(data)
	local ok = typeof(writefile) == "function" and pcall(writefile, file, json)
	if not ok then
		self.Memory = self.Memory or {}
		self.Memory[file] = json -- fallback silencioso: memória
	end
	return ok and true or false
end

-- aplica alias de flags antigas (ex.: CrezUI.* -> DerbyBloom.*) lido do _flags do arquivo
local function aplicarAlias(data, aliases)
	if typeof(aliases) ~= "table" then return end
	for antiga, nova in pairs(aliases) do
		if data[antiga] ~= nil and data[nova] == nil then
			data[nova] = data[antiga]
		end
	end
end

function UI:LoadConfig(file)
	file = file or CONFIG.ConfigFile
	local json
	local function ler(arq)
		if typeof(isfile) == "function" and typeof(readfile) == "function" then
			local ok, res = pcall(function()
				if isfile(arq) then return readfile(arq) end
			end)
			if ok then return res end
		end
		return nil
	end
	json = ler(file)
	-- fallback para o nome antigo de config (migracao de arquivo CrezUI_config.json)
	if not json then json = ler("CrezUI_config.json") end
	json = json or (self.Memory and self.Memory[file])
	if not json then return false end
	local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
	if not ok or typeof(data) ~= "table" then return false end
	aplicarAlias(data, data._flags)
	for flag, v in pairs(data) do
		if flag == "_v" or flag == "_flags" then continue end
		local ctl = self.Controls[flag]
		if ctl then
			if typeof(v) == "table" and v.__color then v = U.fromHex(v.__color) end
			if v ~= nil then ctl:Set(v) end
		end
	end
	return true
end

function UI:CreateWindow(opts)
	opts = opts or {}
	if self.Window then return self.Window end
	local ui = self
	if opts.ToggleKey then ui.ToggleKey = opts.ToggleKey end
	if opts.Icon and ui.FloatIcon then ui.FloatIcon.Image = opts.Icon end
	local win = setmetatable({
		UI = ui, Tabs = {}, Minimized = false, Dragged = false, SearchActive = false,
		UserPicked = false, Size = L.Desktop,
	}, Window)
	ui.Window = win

	local root = create("Frame", {
		Name = "Window", BackgroundTransparency = 1, Size = UDim2.fromOffset(L.Desktop.X, L.Desktop.Y),
		ZIndex = 1, Visible = ui.Visible, Parent = ui.Canvas,
	})
	win.Root = root
	-- sombra falsa: Frame escuro deslocado atrás da janela
	local shadow = U.frame({
		Name = "Shadow", BackgroundColor3 = C.Shadow, BackgroundTransparency = .65,
		Position = UDim2.fromOffset(4, 6), Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = root,
	})
	U.corner(shadow, L.CornerWindow)
	local main = U.frame({
		Name = "Main", BackgroundColor3 = C.Background, Size = UDim2.fromScale(1, 1),
		ClipsDescendants = true, ZIndex = 2, Parent = root,
	})
	U.corner(main, L.CornerWindow)
	U.stroke(main, C.Stroke)

	local bgId = opts.Background or CONFIG.Background
	if bgId and bgId ~= "" then
		local bg = create("ImageLabel", {
			Name = "Background", BackgroundTransparency = 1, Image = bgId, ScaleType = Enum.ScaleType.Crop,
			ImageTransparency = opts.BackgroundImageTransparency or CONFIG.BackgroundTransparency,
			Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = main,
		})
		U.corner(bg, L.CornerWindow)
	end

	-- header
	local header = U.frame({ Name = "Header", BackgroundColor3 = C.Header, Size = UDim2.new(1, 0, 0, L.Header), Parent = main })
	U.corner(header, L.CornerWindow)
	win.HeaderFill = U.frame({
		BackgroundColor3 = C.Header, Position = UDim2.new(0, 0, 1, -L.CornerWindow),
		Size = UDim2.new(1, 0, 0, L.CornerWindow), Parent = header,
	})
	local dragArea = create("Frame", {
		Name = "DragArea", BackgroundTransparency = 1, Size = UDim2.new(1, -(2 * L.Hit + 12), 1, 0), Parent = header,
	})
	local iconId = opts.Icon or ui.Icon
	local textX = 14
	if iconId and iconId ~= "" then
		local ic = create("ImageLabel", {
			Name = "Icon", BackgroundTransparency = 1, Image = iconId, ScaleType = Enum.ScaleType.Fit,
			Position = UDim2.fromOffset(12, (L.Header - 28) / 2), Size = UDim2.fromOffset(28, 28), Parent = dragArea,
		})
		U.corner(ic, 8)
		textX = 48
	end
	local author = opts.Author or CONFIG.Author
	U.label({
		Text = opts.Title or CONFIG.Title, Font = F.Bold, TextSize = L.TitleSize,
		Position = UDim2.fromOffset(textX, author and 6 or 0), Size = UDim2.new(1, -textX, 0, author and 22 or L.Header),
		Parent = dragArea,
	})
	if author then
		U.label({
			Text = author, TextColor3 = C.SubText, TextSize = L.SmallSize - 1,
			Position = UDim2.fromOffset(textX, 27), Size = UDim2.new(1, -textX, 0, 14), Parent = dragArea,
		})
	end

	local function headerBtn(xOff)
		local b = U.button({
			BackgroundColor3 = C.Header, AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, xOff, 0, (L.Header - L.Hit) / 2), Size = UDim2.fromOffset(L.Hit, L.Hit), Parent = header,
		})
		U.corner(b, 8)
		U.hover(b, C.Header, C.Stroke)
		return b
	end
	local closeBtn = headerBtn(-4)
	for _, rot in ipairs({ 45, -45 }) do
		create("Frame", {
			BackgroundColor3 = C.Text, BorderSizePixel = 0, AnchorPoint = Vector2.new(.5, .5),
			Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(16, 2), Rotation = rot, Parent = closeBtn,
		})
	end
	local minBtn = headerBtn(-4 - L.Hit)
	create("Frame", {
		BackgroundColor3 = C.Text, BorderSizePixel = 0, AnchorPoint = Vector2.new(.5, .5),
		Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(16, 2), Parent = minBtn,
	})
	closeBtn.Activated:Connect(function() ui:SetVisible(false) end)
	minBtn.Activated:Connect(function() win:SetMinimized(not win.Minimized) end)

	local startMouse, startPos = Vector2.zero, Vector2.zero
	U.drag(dragArea, {
		start = function(input)
			ui:ClosePopup()
			startMouse = Vector2.new(input.Position.X, input.Position.Y)
			startPos = Vector2.new(root.Position.X.Offset, root.Position.Y.Offset)
		end,
		move = function(input)
			win.Dragged = true
			win:_place(startPos + (Vector2.new(input.Position.X, input.Position.Y) - startMouse) / U.factor)
		end,
	})

	-- corpo
	local body = create("Frame", {
		Name = "Body", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, L.Header),
		Size = UDim2.new(1, 0, 1, -L.Header), Parent = main,
	})
	win.Body = body

	-- busca global
	local searchHolder = U.frame({
		Name = "Search", BackgroundTransparency = .25, Position = UDim2.fromOffset(L.Pad, L.Pad), Size = UDim2.new(1, -2 * L.Pad, 0, L.Hit), Parent = body,
	})
	U.corner(searchHolder, L.Corner)
	local searchStroke = U.stroke(searchHolder, C.Stroke)
	win.SearchBox = U.box({
		PlaceholderText = T.Search, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), Parent = searchHolder,
	})
	win.SearchBox.Focused:Connect(function() U.tween(searchStroke, A.Fast, { Color = C.Accent }) end)
	win.SearchBox.FocusLost:Connect(function() U.tween(searchStroke, A.Fast, { Color = C.Stroke }) end)
	win.SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		win._searchToken = (win._searchToken or 0) + 1
		local my = win._searchToken
		task.delay(0.15, function()
			if my == win._searchToken then win:_search(win.SearchBox.Text) end
		end)
	end)

	-- sidebar (telas grandes) e chips (telas pequenas)
	win.Sidebar = U.frame({ Name = "Sidebar", BackgroundTransparency = .25, Parent = body })
	U.corner(win.Sidebar, L.Corner)
	U.stroke(win.Sidebar, C.Stroke)
	win.SideList = U.scroller({ Parent = win.Sidebar })
	U.pad(win.SideList, 6, 6, 6, 6)
	U.list(win.SideList, 4)

	win.Chips = create("ScrollingFrame", {
		Name = "Chips", BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = L.ScrollBar, ScrollBarImageColor3 = C.Scroll,
		ElasticBehavior = Enum.ElasticBehavior.Always, Visible = false, Parent = body,
	})
	U.list(win.Chips, 6, Enum.FillDirection.Horizontal)

	-- host das páginas + resultados de busca + voltar ao topo
	local host = create("Frame", { Name = "PageHost", BackgroundTransparency = 1, ClipsDescendants = true, Parent = body })
	win.PageHost = host
	win.SearchPage = U.scroller({ Name = "SearchPage", Visible = false, Parent = host })
	U.pad(win.SearchPage, 0, 0, L.ScrollBar + 4, 8)
	U.list(win.SearchPage, 6)
	win.TopBtn = U.button({
		Name = "Top", BackgroundColor3 = C.Header, AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -10), Size = UDim2.fromOffset(L.Hit, L.Hit), ZIndex = 10, Visible = false, Parent = host,
	})
	U.corner(win.TopBtn, L.Hit / 2)
	U.stroke(win.TopBtn, C.Stroke)
	U.chevron(win.TopBtn, true, C.Accent)
	win.TopBtn.Activated:Connect(function()
		if win.Active then U.tween(win.Active.Page, A.Slow, { CanvasPosition = Vector2.new(0, 0) }) end
	end)

	win:_layout()
	return win
end

function Window:_place(pos)
	local f, vp = U.factor, U.viewport()
	local rw, rh = self.Root.Size.X.Offset, self.Root.Size.Y.Offset
	self.Root.Position = UDim2.fromOffset(
		math.clamp(pos.X, 0, math.max(0, vp.X / f - rw)),
		math.clamp(pos.Y, 0, math.max(0, vp.Y / f - rh))
	)
	self.UI:ClosePopup() -- fecha popup ao arrastar a janela (D-07)
end

function Window:_layout()
	local f, vp = U.factor, U.viewport()
	local small = vp.X < L.SmallBreakpoint
	self.Small = small
	local w, h
	if small then
		w, h = vp.X * L.SmallWidth / f, vp.Y * L.SmallHeight / f
	else
		w, h = L.Desktop.X, L.Desktop.Y
	end
	w, h = math.min(w, vp.X * .98 / f), math.min(h, vp.Y * .98 / f)
	self.Size = Vector2.new(w, h)
	self.Root.Size = UDim2.fromOffset(w, self.Minimized and L.Header or h)

	local pad = L.Pad
	local top = 2 * pad + L.Hit
	self.Sidebar.Visible = not small
	self.Chips.Visible = small
	if small then
		local chipsH = L.Hit + 6
		self.Chips.Position = UDim2.fromOffset(pad, top)
		self.Chips.Size = UDim2.new(1, -2 * pad, 0, chipsH)
		local pt = top + chipsH + 4
		self.PageHost.Position = UDim2.fromOffset(pad, pt)
		self.PageHost.Size = UDim2.new(1, -2 * pad, 1, -(pt + pad))
	else
		self.Sidebar.Position = UDim2.fromOffset(pad, top)
		self.Sidebar.Size = UDim2.new(0, L.Sidebar, 1, -(top + pad))
		local pl = L.Sidebar + 2 * pad
		self.PageHost.Position = UDim2.fromOffset(pl, top)
		self.PageHost.Size = UDim2.new(1, -(pl + pad), 1, -(top + pad))
	end

	if self.Dragged then
		self:_place(Vector2.new(self.Root.Position.X.Offset, self.Root.Position.Y.Offset))
	else
		self:_place(Vector2.new((vp.X / f - w) / 2, (vp.Y / f - h) / 2))
	end
end

function Window:SetMinimized(m)
	self.Minimized = m
	self.UI:ClosePopup()
	if m then
		U.tween(self.Root, A.Normal, { Size = UDim2.fromOffset(self.Size.X, L.Header) })
		self.HeaderFill.Visible = false
		task.delay(A.Normal, function()
			if self.Minimized then self.Body.Visible = false end
		end)
	else
		self.Body.Visible = true
		self.HeaderFill.Visible = true
		U.tween(self.Root, A.Normal, { Size = UDim2.fromOffset(self.Size.X, self.Size.Y) })
	end
end

function Window:_updateTop()
	local p = self.Active and self.Active.Page
	self.TopBtn.Visible = p ~= nil and not self.SearchActive and not self.Minimized
		and p.CanvasPosition.Y > 120 and p.AbsoluteCanvasSize.Y > p.AbsoluteSize.Y * 1.5
end

function Window:SelectTab(tab, instant)
	self.Active = tab
	for _, t in ipairs(self.Tabs) do
		local sel = t == tab
		t.Selected = sel
		t:_style(sel)
		t.Page.Visible = sel and not self.SearchActive
	end
	if not instant and not self.SearchActive then
		tab.Page.Position = UDim2.fromOffset(0, 12)
		U.tween(tab.Page, A.Normal, { Position = UDim2.fromOffset(0, 0) })
	end
	self:_updateTop()
end

function Window:CreateTab(name, order)
	local ui = self.UI
	local tab = setmetatable({
		Window = self, UI = ui, Name = name, Order = order or (#self.Tabs + 1), Sections = {}, Selected = false,
	}, Tab)
	tab.Page = U.scroller({ Name = name, Visible = false, Parent = self.PageHost })
	U.pad(tab.Page, 0, 0, L.ScrollBar + 4, 8)
	U.list(tab.Page, 8)
	tab.Page:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		if self.Active == tab then self:_updateTop() end
		self.UI:ClosePopup() -- fecha popup ao rolar a pagina (D-07)
	end)

	tab.Button = U.button({
		Name = name, BackgroundColor3 = C.Accent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, L.Hit),
		Text = name, TextColor3 = C.SubText, LayoutOrder = tab.Order, Parent = self.SideList,
	})
	U.corner(tab.Button, 8)
	tab.Chip = U.button({
		Name = name, BackgroundColor3 = C.Accent, BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, L.Hit),
		AutomaticSize = Enum.AutomaticSize.X, Text = name, TextColor3 = C.SubText, LayoutOrder = tab.Order, Parent = self.Chips,
	})
	U.corner(tab.Chip, 8)
	U.pad(tab.Chip, 16, 0, 16, 0)
	local function pick()
		self.UserPicked = true
		self.SearchBox.Text = ""
		self:SelectTab(tab)
	end
	tab.Button.Activated:Connect(pick)
	tab.Chip.Activated:Connect(pick)

	table.insert(self.Tabs, tab)
	table.sort(self.Tabs, function(a, b) return a.Order < b.Order end)
	if not self.UserPicked then self:SelectTab(self.Tabs[1], true) end
	ui:_bindAccent(function() tab:_style(tab.Selected) end)
	return tab
end

function Tab:_style(selected)
	for _, b in ipairs({ self.Button, self.Chip }) do
		U.tween(b, A.Normal, {
			BackgroundColor3 = C.Accent, BackgroundTransparency = selected and .85 or 1,
			TextColor3 = selected and C.Accent or C.SubText,
		})
	end
end

function Window:_search(raw)
	local ui = self.UI
	local q = (raw or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
	for _, c in ipairs(self.SearchPage:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	if q == "" then
		self.SearchActive = false
		self.SearchPage.Visible = false
		if self.Active then self:SelectTab(self.Active, true) end
		return
	end
	self.SearchActive = true
	for _, t in ipairs(self.Tabs) do t.Page.Visible = false end
	self.SearchPage.Visible = true
	self.TopBtn.Visible = false
	local shown = 0
	for _, entry in ipairs(ui.Registry) do
		if entry.Name and string.find(entry.Name:lower(), q, 1, true) then
			shown += 1
			local b = U.button({
				BackgroundColor3 = C.Surface, Size = UDim2.new(1, 0, 0, L.Row), LayoutOrder = shown, Parent = self.SearchPage,
			})
			U.corner(b, 8)
			U.stroke(b, C.Stroke)
			U.label({
				Text = entry.Name, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(.6, -12, 1, 0),
				TextTruncate = Enum.TextTruncate.AtEnd, Parent = b,
			})
			U.label({
				Text = entry.Tab.Name, TextColor3 = C.Accent, TextSize = L.SmallSize, TextXAlignment = Enum.TextXAlignment.Right,
				Position = UDim2.new(.6, 0, 0, 0), Size = UDim2.new(.4, -12, 1, 0), Parent = b,
			})
			b.Activated:Connect(function() self:Goto(entry) end)
		end
	end
	if shown == 0 then
		U.label({
			Text = T.NoResults, TextColor3 = C.SubText, TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, L.Row), Parent = self.SearchPage,
		})
	end
end

-- pula para a aba do controle, rola até ele e dá um flash
function Window:Goto(entry)
	self.SearchBox.Text = ""
	self.UserPicked = true
	self:SelectTab(entry.Tab)
	task.spawn(function()
		task.wait(.05)
		local row, page = entry.Row, entry.Tab.Page
		if not row.Parent then return end
		local y = (row.AbsolutePosition.Y - page.AbsolutePosition.Y) / U.factor + page.CanvasPosition.Y
		page.CanvasPosition = Vector2.new(0, math.max(0, y - 8))
		row.BackgroundColor3 = C.Accent
		row.BackgroundTransparency = .7
		U.tween(row, .9, { BackgroundTransparency = 1 })
	end)
end

function Window:Destroy()
	for _, t in ipairs(self.Tabs) do t:Destroy() end
	if self.Root then pcall(function() self.Root:Destroy() end) end
	self.UI.Window = nil
end
function Tab:Destroy()
	for _, s in ipairs(self.Sections) do s:Destroy() end
	for _, b in ipairs({ self.Page, self.Button, self.Chip }) do
		if b then pcall(function() b:Destroy() end) end
	end
	self.Sections = {}
end

-- ---------- Section ----------
function Tab:CreateSection(title)
	local sec = setmetatable({ Tab = self, UI = self.UI, Window = self.Window, Name = title, N = 0 }, Section)
	local card = U.frame({
		Name = title, BackgroundTransparency = .2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = #self.Sections + 1, Parent = self.Page,
	})
	U.corner(card, L.Corner)
	U.stroke(card, C.Stroke)
	U.pad(card, 10, 8, 10, 8)
	U.list(card, 4)
	U.label({
		Text = string.upper(title), Font = F.Bold, TextSize = L.SmallSize, TextColor3 = C.SubText,
		Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 0, Parent = card,
	})
	sec.Card = card
	table.insert(self.Sections, sec)
	return sec
end
function Section:_row(height, clickable)
	self.N += 1
	local props = {
		BackgroundColor3 = C.Accent, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height), LayoutOrder = self.N, Parent = self.Card,
	}
	local row = clickable and U.button(props) or U.frame(props)
	U.corner(row, 8)
	return row
end

function Section:_hook(label, desc)
	if not desc then return end
	local ui = self.UI
	U.longPress(label, CONFIG.Tooltip.Hold, function(input)
		ui:ShowTooltip(desc, U.pointer(input))
	end)
end

-- registra controle com flag: setter(v) atualiza o visual e devolve o valor aceito (ou nil)
function Section:_register(kind, opts, row, default, setter)
	local ui = self.UI
	local flag = ui:_uniqueFlag(opts.Flag or opts.Name)
	local ctl = { Flag = flag, Kind = kind, Row = row, Default = default, Value = default }
	function ctl:Set(v, silent)
		local nv = setter(v)
		if nv == nil then return end
		local changed = not U.iguais(nv, self.Value)
		self.Value = nv
		ui.Flags[flag] = nv
		if changed and not silent and opts.Callback then
			task.spawn(function()
				local ok, err = pcall(opts.Callback, nv)
				if not ok then
					warn("[derbybloom] callback '" .. tostring(flag) .. "' falhou: " .. tostring(err))
				end
			end)
		end
	end
	function ctl:Get() return self.Value end
	function ctl:Reset() self:Set(self.Default) end
	-- rastreamento de conexoes por controle (resolve D-06)
	ctl.Conns = {}
	function ctl:_conn(signal, fn)
		table.insert(self.Conns, signal:Connect(fn))
	end
	function ctl:Destroy()
		for _, c in ipairs(self.Conns) do pcall(function() c:Disconnect() end) end
		self.Conns = {}
		local ui = self.UI
		ui.Controls[self.Flag] = nil
		ui.Flags[self.Flag] = nil
		for i, e in ipairs(ui.Registry) do
			if e.Id == self.Flag then table.remove(ui.Registry, i); break end
		end
		if self.Row then pcall(function() self.Row:Destroy() end) end
	end
	local first = setter(default)
	if first ~= nil then ctl.Value, ctl.Default = first, first end
	ui.Flags[flag] = ctl.Value
	ui.Controls[flag] = ctl
	-- dedupe: id unico (o proprio flag, ja unico); nao insere duplicado no Registry
	local jaExiste = false
	for _, e in ipairs(ui.Registry) do
		if e.Id == flag then jaExiste = true; break end
	end
	if not jaExiste then
		table.insert(ui.Registry, { Id = flag, Name = opts.Name, Tab = self.Tab, Row = row })
	end
	self.Last = ctl
	return ctl
end

