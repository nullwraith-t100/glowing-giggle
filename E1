function Section:ColorPicker(opts)
	local ui = self.UI
	local hsv = { 0, 0, 1 }
	if opts.Default and typeof(opts.Default) == "Color3" then
		hsv[1], hsv[2], hsv[3] = opts.Default:ToHSV()
	end
	local fromPicker = false
	local row = self:_row(L.Row, false)
	local label = U.label({ Text = opts.Name, Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -72, 1, 0), Parent = row })
	self:_hook(label, opts.Description)
	local swatch = U.button({
		AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -4, .5, 0), Size = UDim2.fromOffset(56, L.Hit), Parent = row,
	})
	U.corner(swatch, 8)
	U.stroke(swatch, C.Stroke)
	local function setter(v)
		if typeof(v) == "string" then v = U.fromHex(v) end
		if typeof(v) ~= "Color3" then return nil end
		if not fromPicker then hsv[1], hsv[2], hsv[3] = v:ToHSV() end
		swatch.BackgroundColor3 = v
		return v
	end
	local ctl = self:_register("ColorPicker", opts, row, opts.Default or Color3.fromRGB(255, 255, 255), setter)

	swatch.Activated:Connect(function()
		ui:OpenPopup(swatch, 220, 238, function(frame)
			local sv = U.frame({
				BackgroundColor3 = Color3.fromHSV(hsv[1], 1, 1), Position = UDim2.fromOffset(10, 10),
				Size = UDim2.fromOffset(200, 130), Parent = frame,
			})
			U.corner(sv, 6)
			local white = U.frame({ BackgroundColor3 = C.White, Size = UDim2.fromScale(1, 1), Parent = sv })
			U.corner(white, 6)
			create("UIGradient", {
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
				Parent = white,
			})
			local black = U.frame({ BackgroundColor3 = C.Black, Size = UDim2.fromScale(1, 1), Parent = sv })
			U.corner(black, 6)
			create("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
				Parent = black,
			})
			local svCursor = U.frame({
				BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(14, 14), Parent = sv,
			})
			U.corner(svCursor, 7)
			U.stroke(svCursor, C.White, 2)

			local hue = U.frame({
				BackgroundColor3 = C.White, Position = UDim2.fromOffset(10, 150), Size = UDim2.fromOffset(200, 24), Parent = frame,
			})
			U.corner(hue, 6)
			local kps = {}
			for i = 0, 6 do
				kps[#kps + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i == 6 and 0 or i / 6, 1, 1))
			end
			create("UIGradient", { Color = ColorSequence.new(kps), Parent = hue })
			local hueCursor = U.frame({
				BackgroundColor3 = C.White, AnchorPoint = Vector2.new(.5, .5),
				Size = UDim2.fromOffset(6, 30), Parent = hue,
			})
			U.corner(hueCursor, 3)
			U.stroke(hueCursor, C.Black, 1)

			local preview = U.frame({
				Position = UDim2.fromOffset(10, 190), Size = UDim2.fromOffset(40, L.Hit - 4), Parent = frame,
			})
			U.corner(preview, 8)
			U.stroke(preview, C.Stroke)
			local hexHolder = U.frame({
				BackgroundColor3 = C.Background, Position = UDim2.fromOffset(58, 190), Size = UDim2.fromOffset(152, L.Hit - 4), Parent = frame,
			})
			U.corner(hexHolder, 8)
			U.stroke(hexHolder, C.Stroke)
			local hexBox = U.box({
				Font = F.Medium, TextXAlignment = Enum.TextXAlignment.Center, PlaceholderText = "#RRGGBB",
				Size = UDim2.fromScale(1, 1), Parent = hexHolder,
			})
			local hexBoxFocused = false
			hexBox.Focused:Connect(function() hexBoxFocused = true end)
			hexBox.FocusLost:Connect(function() hexBoxFocused = false end)

			local function refresh()
				sv.BackgroundColor3 = Color3.fromHSV(hsv[1], 1, 1)
				svCursor.Position = UDim2.fromScale(hsv[2], 1 - hsv[3])
				hueCursor.Position = UDim2.fromScale(hsv[1], .5)
				preview.BackgroundColor3 = ctl.Value
				if not hexBoxFocused then hexBox.Text = U.toHex(ctl.Value) end
			end
			local function apply()
				fromPicker = true
				ctl:Set(Color3.fromHSV(hsv[1], hsv[2], hsv[3]))
				fromPicker = false
				refresh()
			end
			local function svMove(input)
				local p = U.pointer(input)
				hsv[2] = math.clamp((p.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
				hsv[3] = 1 - math.clamp((p.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
				apply()
			end
			local function hueMove(input)
				hsv[1] = math.clamp((U.pointer(input).X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, .999)
				apply()
			end
			U.drag(sv, { start = svMove, move = svMove })
			U.drag(hue, { start = hueMove, move = hueMove })
			hexBox.FocusLost:Connect(function()
				local c = U.fromHex(hexBox.Text)
				if c then ctl:Set(c) end
				refresh()
			end)
			refresh()
		end)
	end)
	return self
end

