-- Menu de contexto acionado por clique longo ou botao direito.
-- opts: { Items: {{Name, Callback}}, Anchor (GuiObject), Width? }

local function Section_ContextMenu(self, opts)
	local ui = self.UI
	local anchor = opts.Anchor or (self.Last and self.Last.Row)
	local items = opts.Items or {}
	local w = opts.Width or 160
	local h = math.min(#items * (L.Hit + 2) + 8, L.PopupMax)
	if #items == 0 then return self end
	ui:OpenPopup(anchor, w, h, function(frame)
		U.pad(frame, 4, 4, 4 + L.ScrollBar, 4)
		U.list(frame, 2)
		for _, item in ipairs(items) do
			local b = U.button({
				BackgroundColor3 = C.Surface, Size = UDim2.new(1, 0, 0, L.Hit),
				Text = item.Name, TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left,
				Parent = frame,
			})
			U.corner(b, 6)
			U.stroke(b, C.Stroke)
			ui:_conn(b.Activated, function()
				ui:ClosePopup()
				if item.Callback then task.spawn(item.Callback) end
			end)
		end
	end)
	return self
end

