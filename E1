-- src/modules/GradientPicker.lua  (F-057)
-- Seletor de gradiente linear (cor inicial, cor final, angulo).
-- opts: { Name, Default: {Color3, Color3, number?}, Description?, Callback? }
-- Valor: { corA: Color3, corB: Color3, angulo: number }

local function Section_GradientPicker(self, opts)
	local ui = self.UI
	local default = opts.Default or { Color3.fromRGB(255, 240, 246), Color3.fromRGB(233, 64, 140), 90 }
	local corA, corB, angulo = default[1], default[2], default[3] or 90

	local row = self:_row(L.Row + 60, false)
	local label = U.label({
		Text = opts.Name, Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -72, 0, L.Hit), Parent = row,
	})
	self:_hook(label, opts.Description)

	local preview = U.frame({
		BackgroundColor3 = C.Background, AnchorPoint = Vector2.new(1, .5),
		Position = UDim2.new(1, -4, .5, 0), Size = UDim2.fromOffset(56, L.Hit), Parent = row,
	})
	U.corner(preview, 8)
	U.stroke(preview, C.Stroke)

	local swatchA = U.button({
		BackgroundColor3 = corA, AnchorPoint = Vector2.new(1, .5),
		Position = UDim2.new(1, -66, 0, L.Hit + 6), Size = UDim2.fromOffset(28, L.Hit - 4), Parent = row,
	})
	U.corner(swatchA, 6)
	U.stroke(swatchA, C.Stroke)
	local swatchB = U.button({
		BackgroundColor3 = corB, AnchorPoint = Vector2.new(1, .5),
		Position = UDim2.new(1, -34, 0, L.Hit + 6), Size = UDim2.fromOffset(28, L.Hit - 4), Parent = row,
	})
	U.corner(swatchB, 6)
	U.stroke(swatchB, C.Stroke)

	local ctl
	local function applyGrad()
		local grad = create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, corA),
				ColorSequenceKeypoint.new(1, corB),
			}),
			Rotation = angulo, Parent = preview,
		})
		-- remove gradiente anterior, se houver
		for _, c in ipairs(preview:GetChildren()) do
			if c ~= grad and c:IsA("UIGradient") then c:Destroy() end
		end
	end
	local function render()
		swatchA.BackgroundColor3 = corA
		swatchB.BackgroundColor3 = corB
		applyGrad()
	end
	local function setter(v)
		if typeof(v) ~= "table" or #v < 2 then return nil end
		corA = typeof(v[1]) == "Color3" and v[1] or corA
		corB = typeof(v[2]) == "Color3" and v[2] or corB
		angulo = tonumber(v[3]) or angulo
		ctl.Value = { corA, corB, angulo }
		ui.Flags[ctl.Flag] = { corA, corB, angulo }
		render()
		return { corA, corB, angulo }
	end

	ctl = self:_register("GradientPicker", opts, row, { corA, corB, angulo }, setter)
	render()

	local function abrirCor(swatch, alvo)
		return function()
			ui:OpenPopup(swatch, 220, 238, function(frame)
				local hsv = { corA:ToHSV() }
				if alvo == "B" then hsv = { corB:ToHSV() } end
				local sv = U.frame({
					BackgroundColor3 = Color3.fromHSV(hsv[1], 1, 1), Position = UDim2.fromOffset(10, 10),
					Size = UDim2.fromOffset(200, 130), Parent = frame,
				})
				U.corner(sv, 6)
				local white = U.frame({ BackgroundColor3 = C.White, Size = UDim2.fromScale(1, 1), Parent = sv })
				U.corner(white, 6)
				create("UIGradient", {
					Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
					Parent = white,
				})
				local black = U.frame({ BackgroundColor3 = C.Black, Size = UDim2.fromScale(1, 1), Parent = sv })
				U.corner(black, 6)
				create("UIGradient", {
					Rotation = 90,
					Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
					Parent = black,
				})
				local cursor = U.frame({
					BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(14, 14), Parent = sv,
				})
				U.corner(cursor, 7)
				U.stroke(cursor, C.White, 2)
				local hue = U.frame({
					BackgroundColor3 = C.White, Position = UDim2.fromOffset(10, 150), Size = UDim2.fromOffset(200, 24), Parent = frame,
				})
				U.corner(hue, 6)
				local kps = {}
				for i = 0, 6 do
					kps[#kps + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i == 6 and 0 or i / 6, 1, 1))
				end
				create("UIGradient", { Color = ColorSequence.new(kps), Parent = hue })
				local hCursor = U.frame({
					BackgroundColor3 = C.White, AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(6, 30), Parent = hue,
				})
				U.corner(hCursor, 3)
				U.stroke(hCursor, C.Black, 1)
				local function refresh()
					sv.BackgroundColor3 = Color3.fromHSV(hsv[1], 1, 1)
					cursor.Position = UDim2.fromScale(hsv[2], 1 - hsv[3])
					hCursor.Position = UDim2.fromScale(hsv[1], .5)
				end
				local function apply()
					local c = Color3.fromHSV(hsv[1], hsv[2], hsv[3])
					if alvo == "A" then corA = c else corB = c end
					ctl:Set({ corA, corB, angulo })
					refresh()
				end
				U.drag(sv, { start = apply, move = apply })
				U.drag(hue, { start = function(i) hsv[1] = math.clamp((U.pointer(i).X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, .999); apply() end, move = function(i) hsv[1] = math.clamp((U.pointer(i).X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, .999); apply() end })
				refresh()
			end)
		end
	end

	ctl:_conn(swatchA.Activated, abrirCor(swatchA, "A"))
	ctl:_conn(swatchB.Activated, abrirCor(swatchB, "B"))

	return self
end

