-- src/modules/NumberInput.lua  (F-052)
-- Campo numerico com incremento/decremento e limites.
-- opts: { Name, Min, Max, Step, Default, Suffix?, Description?, Callback? }
-- Valor: numero

local function Section_NumberInput(self, opts)
	local ui = self.UI
	local min, max, step = opts.Min or 0, opts.Max or 100, opts.Step or 1
	local suffix = opts.Suffix or ""
	local function decimals(n)
		local d = tostring(n):match("%.(%d+)")
		return d and #d or 0
	end
	local dec = math.max(decimals(step), decimals(min), decimals(max))
	local function snap(v)
		v = math.clamp(tonumber(v) or min, min, max)
		v = min + math.floor((v - min) / step + .5) * step
		local m = 10 ^ dec
		return math.clamp(math.floor(v * m + .5) / m, min, max)
	end

	local row = self:_row(L.Row, false)
	local label = U.label({
		Text = opts.Name, Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -110, 1, 0), Parent = row,
	})
	self:_hook(label, opts.Description)

	local holder = U.frame({
		BackgroundColor3 = C.Background, AnchorPoint = Vector2.new(1, .5),
		Position = UDim2.new(1, -4, .5, 0), Size = UDim2.fromOffset(90, L.Hit), Parent = row,
	})
	U.corner(holder, 8)
	U.stroke(holder, C.Stroke)
	U.list(holder, 0, Enum.FillDirection.Horizontal)

	local btnDec = U.button({
		BackgroundColor3 = C.Surface, Size = UDim2.fromOffset(L.Hit, L.Hit), Text = "-",
		TextColor3 = C.Text, Font = F.Bold, TextSize = L.TextSize, Parent = holder,
	})
	U.corner(btnDec, 6)
	local box = U.box({
		BackgroundTransparency = 1, Font = F.Medium, TextSize = L.TextSize,
		TextColor3 = C.Text, PlaceholderColor3 = C.SubText, TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -L.Hit * 2, 1, 0), Parent = holder,
	})
	local btnInc = U.button({
		BackgroundColor3 = C.Surface, Size = UDim2.fromOffset(L.Hit, L.Hit), Text = "+",
		TextColor3 = C.Text, Font = F.Bold, TextSize = L.TextSize, Parent = holder,
	})
	U.corner(btnInc, 6)

	local ctl
	local function render()
		box.Text = tostring(ctl.Value) .. suffix
	end
	local function setter(v)
		local n = snap(v)
		ctl.Value = n
		ui.Flags[ctl.Flag] = n
		render()
		return n
	end

	ctl = self:_register("NumberInput", opts, row, snap(opts.Default or min), setter)
	render()

	local function change(delta)
		ctl:Set(snap(ctl.Value + delta))
	end
	ctl:_conn(btnDec.Activated, function() change(-step) end)
	ctl:_conn(btnInc.Activated, function() change(step) end)
	ctl:_conn(box.FocusLost, function()
		ctl:Set(tonumber(box.Text:gsub(suffix, "")) or ctl.Value)
	end)

	U.pressFx(btnDec, C.Surface)
	U.pressFx(btnInc, C.Surface)

	return self
end

