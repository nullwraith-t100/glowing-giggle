-- Barra de progresso visual, somente leitura, com texto opcional.
-- opts: { Name, Value, Min, Max, Text?, Suffix?, Description? }
-- Metodo: ctl:SetValue(v) / ctl:SetText(t)

local function Section_ProgressBar(self, opts)
	local ui = self.UI
	local min, max = opts.Min or 0, opts.Max or 100
	local value = math.clamp(tonumber(opts.Value) or min, min, max)
	local text = opts.Text or ""

	local row = self:_row(L.Row, false)
	local label = U.label({
		Text = opts.Name, Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(0, 90, 1, 0), Parent = row,
	})
	self:_hook(label, opts.Description)

	local barHolder = U.frame({
		BackgroundColor3 = C.Stroke, AnchorPoint = Vector2.new(1, .5),
		Position = UDim2.new(1, -4, .5, 0), Size = UDim2.new(1, -100, 0, 10), Parent = row,
	})
	U.corner(barHolder, 5)
	local fill = U.frame({ BackgroundColor3 = C.Accent, Size = UDim2.fromScale(0, 1), Parent = barHolder })
	U.corner(fill, 5)

	local txtLabel = U.label({
		Text = text, TextColor3 = C.SubText, TextSize = L.SmallSize,
		Position = UDim2.fromOffset(4, L.Hit + 2), Size = UDim2.new(1, -8, 0, 16), Parent = row,
	})

	local ctl
	local function render()
		local r = max > min and (ctl.Value - min) / (max - min) or 0
		fill.Size = UDim2.fromScale(math.clamp(r, 0, 1), 1)
	end
	local function setter(v)
		if typeof(v) ~= "number" then return nil end
		ctl.Value = math.clamp(v, min, max)
		ui.Flags[ctl.Flag] = ctl.Value
		render()
		return ctl.Value
	end

	ctl = self:_register("ProgressBar", opts, row, value, setter)
	ctl:SetValue = function(v) ctl:Set(v) end
	ctl.SetText = function(t)
		text = tostring(t or "")
		txtLabel.Text = text
	end
	render()
	txtLabel.Text = text

	return self
end

