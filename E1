-- src/modules/RangeSlider.lua  (F-051)
-- Intervalo [min, max] com dois cursores na mesma barra.
-- opts: { Name, Min, Max, Step, Default: {min, max}, Suffix?, Description?, Callback? }
-- Valor: { min, max }

local function Section_RangeSlider(self, opts)
	local ui = self.UI
	local min, max, step = opts.Min or 0, opts.Max or 100, opts.Step or 1
	local suffix = opts.Suffix or ""
	local function decimals(n)
		local d = tostring(n):match("%.(%d+)")
		return d and #d or 0
	end
	local dec = math.max(decimals(step), decimals(min), decimals(max))
	local default = opts.Default or { min, max }
	local dmin = math.clamp(tonumber(default[1]) or min, min, max)
	local dmax = math.clamp(tonumber(default[2]) or max, min, max)
	if dmax < dmin then dmax = dmin end

	local row = self:_row(L.Hit + 56, false)
	local label = U.label({
		Text = opts.Name, Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -120, 0, L.Hit), Parent = row,
	})
	self:_hook(label, opts.Description)

	local box = U.box({
		BackgroundColor3 = C.Background, BackgroundTransparency = 0, Font = F.Medium,
		TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -4, 0, 0), Size = UDim2.fromOffset(112, L.Hit), Parent = row,
	})
	U.corner(box, 8)
	U.stroke(box, C.Stroke)

	local hit = create("Frame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(4, L.Hit + 6),
		Size = UDim2.new(1, -8, 0, 34), Parent = row,
	})
	local bar = U.frame({
		BackgroundColor3 = C.Stroke, AnchorPoint = Vector2.new(0, .5), Position = UDim2.fromScale(0, .5),
		Size = UDim2.new(1, 0, 0, 6), Parent = hit,
	})
	U.corner(bar, 3)
	local fill = U.frame({ BackgroundColor3 = C.Accent, Size = UDim2.fromScale(0, 1), Parent = bar })
	U.corner(fill, 3)

	local knobL = U.frame({
		BackgroundColor3 = C.Knob, AnchorPoint = Vector2.new(.5, .5),
		Position = UDim2.fromScale(0, .5), Size = UDim2.fromOffset(16, 16), Parent = bar,
	})
	U.corner(knobL, 8)
	local knobR = U.frame({
		BackgroundColor3 = C.Knob, AnchorPoint = Vector2.new(.5, .5),
		Position = UDim2.fromScale(1, .5), Size = UDim2.fromOffset(16, 16), Parent = bar,
	})
	U.corner(knobR, 8)

	local function snap(v)
		v = math.clamp(v, min, max)
		v = min + math.floor((v - min) / step + .5) * step
		local m = 10 ^ dec
		return math.clamp(math.floor(v * m + .5) / m, min, max)
	end

	local ctl
	local function render()
		local rL = max > min and (ctl.Value[1] - min) / (max - min) or 0
		local rR = max > min and (ctl.Value[2] - min) / (max - min) or 0
		fill.Position = UDim2.fromScale(rL, 0)
		fill.Size = UDim2.fromScale(math.max(0, rR - rL), 1)
		knobL.Position = UDim2.fromScale(rL, .5)
		knobR.Position = UDim2.fromScale(rR, .5)
		box.Text = string.format("%s%s - %s%s", tostring(ctl.Value[1]), suffix, tostring(ctl.Value[2]), suffix)
	end

	local function setter(v)
		if typeof(v) ~= "table" or #v < 2 then return nil end
		local a = snap(tonumber(v[1]) or ctl.Value[1])
		local b = snap(tonumber(v[2]) or ctl.Value[2])
		if b < a then b = a end
		ctl.Value = { a, b }
		render()
		return { a, b }
	end

	ctl = self:_register("RangeSlider", opts, row, { dmin, dmax }, setter)
	render()

	local page = self.Tab.Page
	local activeKnob = nil
	local function selectKnob(input)
		local p = U.pointer(input)
		local dL = (p - knobL.AbsolutePosition - Vector2.new(8, 8)).Magnitude
		local dR = (p - knobR.AbsolutePosition - Vector2.new(8, 8)).Magnitude
		activeKnob = (dL <= dR) and knobL or knobR
	end

	local function fromInput(input)
		if not activeKnob then return end
		local r = (U.pointer(input).X - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X)
		r = math.clamp(r, 0, 1)
		local v = min + (max - min) * r
		local a, b = ctl.Value[1], ctl.Value[2]
		if activeKnob == knobL then
			a = math.min(snap(v), b)
		else
			b = math.max(snap(v), a)
		end
		ctl:Set({ a, b })
	end

	U.drag(hit, {
		start = function(input)
			selectKnob(input)
			page.ScrollingEnabled = false
			fromInput(input)
		end,
		move = fromInput,
		stop = function()
			activeKnob = nil
			page.ScrollingEnabled = true
		end,
	})

	ctl:_conn(box.FocusLost, function()
		local a, b = box.Text:match("([%d%.%-]+)%s*%-%s*([%d%.%-]+)")
		if a and b then ctl:Set({ tonumber(a), tonumber(b) }) end
	end)

	return self
end

