local C, F, T, L, A = CONFIG.Colors, CONFIG.Fonts, CONFIG.Text, CONFIG.Layout, CONFIG.Anim
local U = { factor = 1, releaseTick = 0 }

local function merge(base, extra)
	for k, v in pairs(extra) do base[k] = v end
	return base
end

local function create(class, props)
	local inst = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do inst[k] = v end
	inst.Parent = parent -- parent por último (menos recálculo)
	return inst
end

function U.isPress(input)
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
end

-- ÚNICO ponto de conversão: px base -> px reais
function U.scale(n) return n * U.factor end

function U.viewport()
	local cam = workspace.CurrentCamera
	return cam and cam.ViewportSize or L.RefSize
end

function U.computeFactor()
	local vp = U.viewport()
	U.factor = math.clamp(math.min(vp.X / L.RefSize.X, vp.Y / L.RefSize.Y), L.ScaleMin, L.ScaleMax)
	return U.factor
end

-- posição do input no mesmo espaço do AbsolutePosition (ScreenGui com IgnoreGuiInset)
function U.pointer(input)
	return Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
end

function U.tween(inst, time, props)
	local tw = TweenService:Create(inst, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- igualdade profunda: duas tabelas com o mesmo conteudo sao iguais (evita callback espurio em MultiDropdown/Reset/LoadConfig)
function U.iguais(a, b)
	if a == b then return true end
	if typeof(a) ~= typeof(b) then return false end
	if typeof(a) ~= "table" then return a == b end
	local ca, cb = 0, 0
	for k, v in pairs(a) do
		cb += 1
		if not U.iguais(v, b[k]) then return false end
		ca += 1
	end
	for _ in pairs(b) do cb -= 1 end
	return cb == 0
end

function U.frame(props)
	return create("Frame", merge({ BackgroundColor3 = C.Surface, BorderSizePixel = 0 }, props))
end

function U.label(props)
	return create("TextLabel", merge({
		BackgroundTransparency = 1, BorderSizePixel = 0, Font = F.Regular, TextSize = L.TextSize,
		TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left,
	}, props))
end

function U.button(props)
	return create("TextButton", merge({
		BackgroundColor3 = C.Surface, BorderSizePixel = 0, AutoButtonColor = false, Text = "",
		Font = F.Medium, TextSize = L.TextSize, TextColor3 = C.Text,
	}, props))
end

function U.box(props)
	return create("TextBox", merge({
		BackgroundTransparency = 1, BorderSizePixel = 0, Font = F.Regular, TextSize = L.TextSize,
		TextColor3 = C.Text, PlaceholderColor3 = C.SubText, ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left, Text = "",
	}, props))
end

function U.scroller(props)
	return create("ScrollingFrame", merge({
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, ScrollBarThickness = L.ScrollBar,
		ScrollBarImageColor3 = C.Scroll, ElasticBehavior = Enum.ElasticBehavior.Always,
	}, props))
end

function U.corner(inst, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r), Parent = inst })
end

function U.stroke(inst, color, thickness)
	return create("UIStroke", {
		Color = color or C.Stroke, Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inst,
	})
end

function U.pad(inst, l, t, r, b)
	return create("UIPadding", {
		PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b), Parent = inst,
	})
end

function U.list(inst, gap, dir)
	return create("UIListLayout", {
		Padding = UDim.new(0, gap or 0), SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = dir or Enum.FillDirection.Vertical, Parent = inst,
	})
end

-- seta com dois traços rotacionados (sem assets)
function U.chevron(parent, up, color, pos)
	local holder = create("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5),
		Position = pos or UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(14, 14), Parent = parent,
	})
	local y = up and 8 or 6
	local specs = up and { { 4.5, -45 }, { 9.5, 45 } } or { { 4.5, 45 }, { 9.5, -45 } }
	for _, s in ipairs(specs) do
		create("Frame", {
			BackgroundColor3 = color or C.SubText, BorderSizePixel = 0, AnchorPoint = Vector2.new(.5, .5),
			Position = UDim2.fromOffset(s[1], y), Size = UDim2.fromOffset(9, 2), Rotation = s[2], Parent = holder,
		})
	end
	return holder
end

function U.toHex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + .5), math.floor(c.G * 255 + .5), math.floor(c.B * 255 + .5))
end

function U.fromHex(s)
	local h = tostring(s):gsub("#", "")
	if #h ~= 6 or not h:match("^%x+$") then return nil end
	return Color3.fromRGB(tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16))
end

-- arrasto por mouse E toque; conexões globais só existem durante o arrasto
function U.drag(handle, h)
	handle.InputBegan:Connect(function(input)
		if not U.isPress(input) then return end
		local moveConn, endConn
		if h.start then h.start(input) end
		moveConn = UIS.InputChanged:Connect(function(i)
			local same = i == input
				or (input.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseMovement)
				or (input.UserInputType == Enum.UserInputType.Touch and i.UserInputType == Enum.UserInputType.Touch)
			if same and h.move then h.move(i) end
		end)
		endConn = UIS.InputEnded:Connect(function(i)
			if i == input or i.UserInputType == input.UserInputType then
				moveConn:Disconnect()
				endConn:Disconnect()
				if h.stop then h.stop(i) end
			end
		end)
	end)
end

-- segurar `hold` segundos sem mover (>8px cancela) dispara fn
function U.longPress(obj, hold, fn)
	obj.InputBegan:Connect(function(input)
		if not U.isPress(input) then return end
		local tick, start = U.releaseTick, input.Position
		task.delay(hold, function()
			if U.releaseTick == tick and (input.Position - start).Magnitude < 8 then fn(input) end
		end)
	end)
end

function U.pressFx(btn, normal)
	btn.InputBegan:Connect(function(input)
		if U.isPress(input) then U.tween(btn, A.Fast, { BackgroundColor3 = normal:Lerp(C.Accent, .35) }) end
	end)
	btn.InputEnded:Connect(function(input)
		if U.isPress(input) then U.tween(btn, A.Fast, { BackgroundColor3 = normal }) end
	end)
end

-- hover é só enfeite; nada depende dele
function U.hover(btn, normal, over)
	btn.MouseEnter:Connect(function() U.tween(btn, A.Fast, { BackgroundColor3 = over }) end)
	btn.MouseLeave:Connect(function() U.tween(btn, A.Fast, { BackgroundColor3 = normal }) end)
end

local function decimals(n)
	local d = tostring(n):match("%.(%d+)")
	return d and #d or 0
end

local function validBind(v)
	if v == "None" or v == "MouseButton2" or v == "MouseButton3" then return true end
	local ok, kc = pcall(function() return Enum.KeyCode[v] end)
	return ok and kc ~= nil
end

local function removeOld()
	local lp = Players.LocalPlayer
	local roots = { CoreGui, lp and lp:FindFirstChildOfClass("PlayerGui") }
	local okH, hui = pcall(function() return gethui and gethui() end)
	if okH and typeof(hui) == "Instance" then table.insert(roots, hui) end
	for _, p in pairs(roots) do
		pcall(function()
			local old = p:FindFirstChild(CONFIG.Name)
			if old then old:Destroy() end
		end)
	end
end

local function mount(gui)
	local okH, hui = pcall(function() return gethui and gethui() end)
	if okH and typeof(hui) == "Instance" then
		pcall(function() gui.Parent = hui end)
		if gui.Parent == hui then return end
	end
	pcall(function() gui.Parent = CoreGui end)
	if gui.Parent ~= CoreGui then
		gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	end
end

