	local cMode = section:Dropdown({ Name = "Mode", Options = { "Always", "Hold Key" }, Default = "Always", Flag = "triggerbot_mode" })
	local cKey = section:Keybind({ Name = "Hold Key", Default = Enum.KeyCode.MouseButton2, Flag = "triggerbot_key" })
	local cDelay = section:Slider({ Name = "Delay (ms)", Min = 0, Max = 500, Default = 50, Flag = "triggerbot_delay" })
	local cTeam = section:Toggle({ Name = "Team Check", Default = true, Flag = "triggerbot_team" })

	local function isKeyDown(value)
		if value == "None" then return true end
		local kc = Enum.KeyCode[value]
		if kc then return UIS:IsKeyDown(kc) end
		local mb = Enum.UserInputType[value]
		if mb then return UIS:IsMouseButtonPressed(mb) end
		return false
	end

	local conn
	conn = RunService and game:GetService("RunService").Heartbeat:Connect(function()
		if not ui:Get("triggerbot_enabled") then return end
		local mode = ui:Get("triggerbot_mode")
		if mode == "Hold Key" and not isKeyDown(ui:Get("triggerbot_key")) then return end

		local target = getMouseTarget()
		local ch = getCharacterOfTarget(target)
		if not ch then return end
		if ui:Get("triggerbot_team") and ch.player and ch.player.Team == localPlayer.Team then return end

		local delayMs = ui:Get("triggerbot_delay")
		if delayMs > 0 then
			task.delay(delayMs / 1000, function()
				-- FILL: acionar disparo (fire weapon) -- jogo especifico
				pcall(function() if mouse1click then mouse1click() end end)
			end)
		else
			-- FILL: acionar disparo imediatamente -- jogo especifico
			pcall(function() if mouse1click then mouse1click() end end)
		end
	end)

	return { stop = function() if conn then conn:Disconnect() end end }
end
-- src/modules/hub/ESP.lua  (F-094, F-095, F-096)
-- Depende do jogo alvo: getCamera, getCharacters, worldToScreen e equipe/saude
-- sao especificos de cada titulo.
-- Desenha box, esqueleto, vida, nome, distancia, chams e tracers sobre entidades.
-- Flags: ui:Get("esp_*") / ui:Set("esp_*", v). Controles na aba "ESP".

UI.HubModules.ESP = function(ui, win)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local localPlayer = Players.LocalPlayer

	local drawings = {} -- [player] = { Drawing[] }
	local charEsp = {}  -- [character] = { Box, Tracer, Name, Health, Distance, Skeleton: {line} }

	-- ============ GAME-SPECIFIC: preencha para o jogo alvo ============
	local function getCamera() return workspace.CurrentCamera end
	local function getCharacters()
		local out = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				table.insert(out, {
					player = p, character = p.Character,
					root = p.Character.HumanoidRootPart,
					head = p.Character:FindFirstChild("Head"),
					humanoid = hum,
					team = p.Team,
					health = hum and hum.Health or 0,
					maxHealth = hum and hum.MaxHealth or 100,
				})
			end
		end
		return out
	end
	local function worldToScreen(point)
		local cam = getCamera()
		if not cam then return nil end
		local vp, onScreen = cam:WorldToViewportPoint(point)
		return Vector2.new(vp.X, vp.Y), onScreen, vp.Z
	end
	-- =================================================================

	local section = win:CreateTab("ESP", 20):CreateSection("ESP")
	local cEnabled = section:Toggle({ Name = "Enabled", Default = false, Flag = "esp_enabled" })
	local cTeam = section:Toggle({ Name = "Team Check", Default = true, Flag = "esp_team" })
	local cMaxDist = section:Slider({ Name = "Max Distance", Min = 50, Max = 3000, Default = 1000, Flag = "esp_maxdist" })
	local cBox = section:Toggle({ Name = "Box", Default = true, Flag = "esp_box" })
	local cSkeleton = section:Toggle({ Name = "Skeleton", Default = false, Flag = "esp_skeleton" })
	local cHealth = section:Toggle({ Name = "Health", Default = true, Flag = "esp_health" })
	local cName = section:Toggle({ Name = "Name", Default = true, Flag = "esp_name" })
	local cDistance = section:Toggle({ Name = "Distance", Default = true, Flag = "esp_distance" })
	local cChams = section:Toggle({ Name = "Chams", Default = false, Flag = "esp_chams" })
	local cTracers = section:Toggle({ Name = "Tracers", Default = false, Flag = "esp_tracers" })

	local function colorFor(kind)
		local c = ui:Get("esp_color_" .. kind)
		return c or Color3.fromRGB(255, 255, 255)
	end

	local function createDrawing(kind)
		local ok, d = pcall(function() return Drawing.new(kind) end)
		if ok and d then return d end
		return nil
	end

	local function newEspEntry()
		local e = {}
		e.box = createDrawing("Square")
		if e.box then e.box.Thickness = 1; e.box.Filled = false end
		e.tracer = createDrawing("Line")
		if e.tracer then e.tracer.Thickness = 1 end
		e.name = createDrawing("Text")
		if e.name then e.name.Size = 14; e.name.Center = true; e.name.Outline = true end
		e.health = createDrawing("Text")
		if e.health then e.health.Size = 14; e.health.Center = false; e.health.Outline = true end
		e.distance = createDrawing("Text")
		if e.distance then e.distance.Size = 14; e.distance.Center = true; e.distance.Outline = true end
		e.skeleton = {}
		for _, name in ipairs({ "HeadNeck", "NeckTorso", "TorsoLShoulder", "TorsoRShoulder", "TorsoLHip", "TorsoRHip", "LShoulderLHand", "RShoulderRHand", "LHipLFoot", "RHipRFoot" }) do
			local l = createDrawing("Line")
			if l then l.Thickness = 1 end
			e.skeleton[name] = l
		end
		-- chams: aplicado via Highlight ou adorno no modelo (game-specific)
		e.chamsAdorn = nil
		return e
	end

	local function hideEntry(e)
		if e.box then e.box.Visible = false end
		if e.tracer then e.tracer.Visible = false end
		if e.name then e.name.Visible = false end
		if e.health then e.health.Visible = false end
		if e.distance then e.distance.Visible = false end
		for _, l in pairs(e.skeleton) do if l then l.Visible = false end end
		if e.chamsAdorn then
			pcall(function() e.chamsAdorn:Destroy() end)
			e.chamsAdorn = nil
		end
	end

	local conn = RunService.RenderStepped:Connect(function()
		if not ui:Get("esp_enabled") then
			for _, e in pairs(charEsp) do hideEntry(e) end
			return
		end

		local cam = getCamera()
		local center = cam and Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2) or Vector2.zero
		local seen = {}

		for _, ch in ipairs(getCharacters()) do
			if ui:Get("esp_team") and ch.team == localPlayer.Team then continue end
			local dist = (ch.root.Position - cam.CFrame.Position).Magnitude
			if dist > ui:Get("esp_maxdist") then continue end
			seen[ch.player] = true

			local e = charEsp[ch.player]
			if not e then
				e = newEspEntry()
				charEsp[ch.player] = e
			end

			local headPos = (ch.head and ch.head.Position) or ch.root.Position
			local rootPos = ch.root.Position
			local top2d, topVis, topDepth = worldToScreen(headPos + Vector3.new(0, 0.5, 0))
			local bottom2d, botVis, botDepth = worldToScreen(rootPos - Vector3.new(0, 3, 0))

			if topVis and botVis and topDepth > 0 and botDepth > 0 then
				local height = math.abs(bottom2d.Y - top2d.Y)
				local width = height * 0.5
				local left = top2d.X - width / 2
				local top = top2d.Y

				if ui:Get("esp_box") and e.box then
					e.box.Visible = true
					e.box.Position = Vector2.new(left, top)
					e.box.Size = Vector2.new(width, height)
					e.box.Color = colorFor("box")
				else
					if e.box then e.box.Visible = false end
				end

				if ui:Get("esp_tracers") and e.tracer and center then
					e.tracer.Visible = true
					e.tracer.From = center
					e.tracer.To = bottom2d
					e.tracer.Color = colorFor("tracer")
				else
					if e.tracer then e.tracer.Visible = false end
				end

				if ui:Get("esp_name") and e.name then
					e.name.Visible = true
					e.name.Text = ch.player.Name
					e.name.Position = Vector2.new(top2d.X, top2d.Y - height - 18)
					e.name.Color = colorFor("name")
				else
					if e.name then e.name.Visible = false end
				end

				if ui:Get("esp_health") and e.health and ch.humanoid then
					e.health.Visible = true
					e.health.Text = string.format("%d/%d", math.floor(ch.health), math.floor(ch.maxHealth))
					e.health.Position = Vector2.new(left - 30, top + height / 2)
					local hPct = ch.health / ch.maxHealth
					e.health.Color = Color3.fromRGB(255 * (1 - hPct), 255 * hPct, 0)
				else
					if e.health then e.health.Visible = false end
				end

				if ui:Get("esp_distance") and e.distance then
					e.distance.Visible = true
					e.distance.Text = string.format("%dm", math.floor(dist))
					e.distance.Position = Vector2.new(top2d.X, bottom2d.Y + 2)
					e.distance.Color = colorFor("distance")
				else
					if e.distance then e.distance.Visible = false end
				end

				if ui:Get("esp_skeleton") then
					-- FILL: ligar partes do esqueleto entre si (posicoes game-specific)
					for _, l in pairs(e.skeleton) do if l then l.Visible = false end end
				else
					for _, l in pairs(e.skeleton) do if l then l.Visible = false end end
				end

				if ui:Get("esp_chams") then
					-- FILL: aplicar Highlight/adorno ao modelo (game-specific, sem assets obrigatorios)
				else
					if e.chamsAdorn then pcall(function() e.chamsAdorn:Destroy() end); e.chamsAdorn = nil end
				end
			else
				hideEntry(e)
			end
		end

		-- limpa entradas de jogadores que sairam
		for player, e in pairs(charEsp) do
			if not seen[player] then
				hideEntry(e)
				charEsp[player] = nil
			end
		end
	end)

	return { stop = function()
		if conn then conn:Disconnect() end
		for _, e in pairs(charEsp) do hideEntry(e) end
		charEsp = {}
	end }
end
-- src/modules/hub/Radar.lua  (F-097)
-- Depende do jogo alvo: getCamera, getCharacters e posicoes relativas sao
-- especificos de cada titulo.
-- Minimapa com pontos de jogadores relativos ao local player.
-- Flags: ui:Get("radar_*") / ui:Set("radar_*", v). Controles na aba "Radar".

UI.HubModules.Radar = function(ui, win)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local localPlayer = Players.LocalPlayer

	local radarDrawing = nil

	-- ============ GAME-SPECIFIC: preencha para o jogo alvo ============
	local function getCamera() return workspace.CurrentCamera end
	local function getLocalRoot()
		if localPlayer.Character then return localPlayer.Character:FindFirstChild("HumanoidRootPart") end
		return nil
	end
	local function getCharacters()
		local out = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				table.insert(out, { player = p, root = p.Character.HumanoidRootPart, team = p.Team })
			end
		end
		return out
	end
	local function worldToScreen(point)
		local cam = getCamera()
		if not cam then return nil end
		local vp, onScreen = cam:WorldToViewportPoint(point)
		return Vector2.new(vp.X, vp.Y), onScreen, vp.Z
	end
	-- =================================================================

	local section = win:CreateTab("Radar", 30):CreateSection("Radar")
	local cEnabled = section:Toggle({ Name = "Enabled", Default = false, Flag = "radar_enabled" })
	local cRange = section:Slider({ Name = "Range (studs)", Min = 100, Max = 3000, Default = 500, Flag = "radar_range" })
	local cSize = section:Slider({ Name = "Size (px)", Min = 100, Max = 400, Default = 200, Flag = "radar_size" })
	local cTeam = section:Toggle({ Name = "Team Check", Default = true, Flag = "radar_team" })

	local function createRadar()
		if radarDrawing then return end
		local size = ui:Get("radar_size")
		local d = Drawing.new("Square")
		d.Size = Vector2.new(size, size)
		d.Position = Vector2.new(20, 20)
		d.Color = Color3.fromRGB(40, 40, 40)
		d.Filled = true
		d.Transparency = 0.6
		d.Visible = true
		-- borda
		local border = Drawing.new("Square")
		border.Size = Vector2.new(size + 4, size + 4)
		border.Position = Vector2.new(18, 18)
		border.Color = Color3.fromRGB(255, 255, 255)
		border.Filled = false
		border.Thickness = 2
		border.Visible = true
		radarDrawing = { main = d, border = border, dots = {} }
	end

	local function destroyRadar()
		if radarDrawing then
			pcall(function() radarDrawing.main:Remove() end)
			pcall(function() radarDrawing.border:Remove() end)
			for _, dot in ipairs(radarDrawing.dots) do pcall(function() dot:Remove() end) end
			radarDrawing = nil
		end
	end

	local conn = RunService.RenderStepped:Connect(function()
		if not ui:Get("radar_enabled") then
			destroyRadar()
			return
		end
		createRadar()
		local size = ui:Get("radar_size")
		local range = ui:Get("radar_range")
		local r = radarDrawing
		r.main.Size = Vector2.new(size, size)
		r.main.Position = Vector2.new(20, 20)
		r.border.Size = Vector2.new(size + 4, size + 4)
		r.border.Position = Vector2.new(18, 18)

		local localRoot = getLocalRoot()
		local cam = getCamera()
		local camCF = cam and cam.CFrame or CFrame.new()

		-- recria dots conforme necessario
		local chars = getCharacters()
		while #r.dots < #chars do
			local dot = Drawing.new("Square")
			dot.Size = Vector2.new(5, 5)
			dot.Filled = true
			table.insert(r.dots, dot)
		end
		while #r.dots > #chars do
			local dot = table.remove(r.dots)
			pcall(function() dot:Remove() end)
		end

		local i = 0
		for _, ch in ipairs(chars) do
			i += 1
			local dot = r.dots[i]
			if ui:Get("radar_team") and ch.team == localPlayer.Team then
				dot.Visible = false
				continue
			end
			local localPos = localRoot and localRoot.Position or camCF.Position
			local rel = ch.root.Position - localPos
			if rel.Magnitude > range then
				dot.Visible = false
				continue
			end
			-- projeta posicao relativa no plano do radar (usando LookVector da camera)
			local look = camCF.LookVector
			local right = camCF.RightVector
			local x = rel:Dot(right)
			local y = rel:Dot(look)
			local scale = size / (range * 2)
			local dx = x * scale
			local dy = y * scale
			dot.Visible = true
			dot.Position = Vector2.new(20 + size / 2 + dx - 2.5, 20 + size / 2 - dy - 2.5)
			dot.Color = ch.team == localPlayer.Team and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 50, 50)
		end
	end)

	return { stop = function()
		if conn then conn:Disconnect() end
		destroyRadar()
	end }
end
-- src/modules/hub/Crosshair.lua  (F-098)
-- Mira personalizada desenhada no centro da tela. Nao depende de offset de
-- jogo (usa ViewportSize), mas o ponto central e o da camera do titulo.
-- Flags: ui:Get("crosshair_*") / ui:Set("crosshair_*", v). Controles na aba "Crosshair".

UI.HubModules.Crosshair = function(ui, win)
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	local localPlayer = Players.LocalPlayer

	local drawings = {}

	-- ============ GAME-SPECIFIC: centro da tela da camera do titulo ============
	local function getCamera() return workspace.CurrentCamera end
	local function screenCenter()
		local cam = getCamera()
		if not cam then return Vector2.new(0, 0) end
		return Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
	end
	-- ===========================================================================

	local section = win:CreateTab("Crosshair", 40):CreateSection("Crosshair")
	local cEnabled = section:Toggle({ Name = "Enabled", Default = false, Flag = "crosshair_enabled" })
	local cStyle = section:Dropdown({ Name = "Style", Options = { "Cross", "Dot", "Cross + Dot" }, Default = "Cross", Flag = "crosshair_style" })
	local cSize = section:Slider({ Name = "Size", Min = 2, Max = 30, Default = 8, Flag = "crosshair_size" })
	local cThickness = section:Slider({ Name = "Thickness", Min = 1, Max = 6, Default = 1, Flag = "crosshair_thickness" })
	local cGap = section:Slider({ Name = "Gap", Min = 0, Max = 20, Default = 4, Flag = "crosshair_gap" })
	local cColor = section:ColorPicker({ Name = "Color", Default = Color3.fromRGB(255, 255, 255), Flag = "crosshair_color" })

	local function newLine()
		local ok, d = pcall(function() return Drawing.new("Line") end)
		if ok and d then
			d.Thickness = 1
			d.Visible = false
		end
		return d
	end
	local function newDot()
		local ok, d = pcall(function() return Drawing.new("Circle") end)
		if ok and d then
			d.Filled = true
			d.Visible = false
		end
		return d
	end

	local conn = RunService.RenderStepped:Connect(function()
		local enabled = ui:Get("crosshair_enabled")
		local style = ui:Get("crosshair_style")
		local size = ui:Get("crosshair_size")
		local thick = ui:Get("crosshair_thickness")
		local gap = ui:Get("crosshair_gap")
		local color = ui:Get("crosshair_color") or Color3.fromRGB(255, 255, 255)
		local center = screenCenter()

		if not enabled then
			for _, d in ipairs(drawings) do d.Visible = false end
			return
		end

		-- garante linhas suficientes
		while #drawings < 4 do table.insert(drawings, newLine()) end
		while #drawings > 4 do
			local d = table.remove(drawings)
			pcall(function() d:Remove() end)
		end

		local l1, l2, l3, l4 = drawings[1], drawings[2], drawings[3], drawings[4]
		local half = size / 2
		local inner = gap
		local outer = gap + half

		local function apply(l, from, to)
			l.Visible = true
			l.From = from
			l.To = to
			l.Color = color
			l.Thickness = thick
		end

		if style == "Cross" or style == "Cross + Dot" then
			apply(l1, center + Vector2.new(0, inner), center + Vector2.new(0, outer))       -- cima
			apply(l2, center + Vector2.new(0, -inner), center + Vector2.new(0, -outer))     -- baixo
			apply(l3, center + Vector2.new(inner, 0), center + Vector2.new(outer, 0))       -- direita
			apply(l4, center + Vector2.new(-inner, 0), center + Vector2.new(-outer, 0))     -- esquerda
		else
			for _, l in ipairs(drawings) do l.Visible = false end
		end

		-- ponto central
		if not drawings.dot then drawings.dot = newDot() end
		if style == "Dot" or style == "Cross + Dot" then
			drawings.dot.Visible = true
			drawings.dot.Radius = math.max(2, thick)
			drawings.dot.Position = center - Vector2.new(thick / 2, thick / 2)
			drawings.dot.Color = color
		else
			drawings.dot.Visible = false
		end
	end)

	return { stop = function()
		if conn then conn:Disconnect() end
		for _, d in ipairs(drawings) do pcall(function() d:Remove() end) end
		if drawings.dot then pcall(function() drawings.dot:Remove() end) end
		drawings = {}
	end }
end
-- src/modules/hub/Movement.lua  (F-099)
-- Depende do jogo alvo: Humanoid, WalkSpeed, Jump e CFrame do personagem sao
-- especificos de cada titulo.
-- Bhop (pulo automatico), Speed (multiplicador de velocidade) e Fly.
-- Flags: ui:Get("mov_*") / ui:Set("mov_*", v). Controles na aba "Movement".

UI.HubModules.Movement = function(ui, win)
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	local UIS = game:GetService("UserInputService")
	local localPlayer = Players.LocalPlayer

	local flyConn = nil
	local flyVelocity = nil

	-- ============ GAME-SPECIFIC: preencha para o jogo alvo ============
	local function getHumanoid()
		if localPlayer.Character then
			return localPlayer.Character:FindFirstChildOfClass("Humanoid")
		end
		return nil
	end
	local function getRoot()
		if localPlayer.Character then
			return localPlayer.Character:FindFirstChild("HumanoidRootPart")
		end
		return nil
	end
	local function setWalkSpeed(hum, v)
		if hum then
			-- FILL: alguns jogos travam WalkSpeed; usar SetState ou speed offset se necessario
			pcall(function() hum.WalkSpeed = v end)
		end
	end
	local function setJumpPower(hum, v)
		if hum then pcall(function() hum.JumpPower = v end) end
	end
	local function requestJump()
		local hum = getHumanoid()
		if hum then pcall(function() hum.Jump = true end) end
	end
	-- =================================================================

	local section = win:CreateTab("Movement", 50):CreateSection("Movement")
	local cBhop = section:Toggle({ Name = "Bhop (pulo auto)", Default = false, Flag = "mov_bhop" })
	local cSpeed = section:Toggle({ Name = "Speed", Default = false, Flag = "mov_speed" })
	local cSpeedMult = section:Slider({ Name = "Speed Multiplier", Min = 1, Max = 10, Default = 2, Flag = "mov_speedmult" })
	local cFly = section:Toggle({ Name = "Fly", Default = false, Flag = "mov_fly" })
	local cFlySpeed = section:Slider({ Name = "Fly Speed", Min = 10, Max = 200, Default = 60, Flag = "mov_flyspeed" })

	-- Bhop: pula automaticamente quando toca o chao
	local bhopConn = RunService.Heartbeat:Connect(function()
		if not ui:Get("mov_bhop") then return end
		local hum = getHumanoid()
		if not hum then return end
		-- FILL: detectar estado de chão (FloorMaterial / Humanoid.FloorMaterial ~= nil)
		local onGround = (hum.FloorMaterial ~= nil and hum.FloorMaterial ~= Enum.Material.Air)
		if onGround then requestJump() end
	end)

	-- Speed
	local speedConn = RunService.Heartbeat:Connect(function()
		if not ui:Get("mov_speed") then return end
		local hum = getHumanoid()
		if not hum then return end
		local base = 16 -- walkspeed base padrao do Roblox; FILL: ler do jogo alvo
		setWalkSpeed(hum, base * ui:Get("mov_speedmult"))
	end)

	-- Fly: CFrame baseado na camera, teclas WASD
	local function startFly()
		if flyConn then return end
		flyConn = RunService.RenderStepped:Connect(function()
			if not ui:Get("mov_fly") then
				stopFly()
				return
			end
			local root = getRoot()
			local cam = game:GetService("Workspace").CurrentCamera
			if not root or not cam then return end
			local speed = ui:Get("mov_flyspeed")
			local dir = Vector3.zero
			if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
			if dir.Magnitude > 0 then dir = dir.Unit end
			local move = dir * (speed / 60) -- passo por frame aproximado
			root.CFrame = root.CFrame + move
			-- FILL: anular velocidade fisica (root.AssemblyLinearVelocity = Vector3.zero) se necessario
		end)
	end
	local function stopFly()
		if flyConn then flyConn:Disconnect(); flyConn = nil end
	end

	local flyToggle = ui.Controls["mov_fly"]
	if flyToggle then
		flyToggle:_conn(flyToggle:Get and function() end, function() end) -- placeholder; abaixo usa o valor diretamente
	end
	-- Liga/desliga fly com base no valor do toggle (verificado no loop acima via stopFly)

	return { stop = function()
		bhopConn:Disconnect()
		speedConn:Disconnect()
		stopFly()
	end }
end
-- src/modules/hub/Navigation.lua  (F-100, parte 1)
-- Depende do jogo alvo: HumanoidRootPart.CFrame e teleporte sao especificos
-- de cada titulo.
-- Waypoints (adicionar, listar, teleportar), teleport para jogador.
-- Flags: ui:Get("nav_*") / ui:Set("nav_*", v). Controles na aba "Navigation".

UI.HubModules.Navigation = function(ui, win)
	local Players = game:GetService("Players")
	local localPlayer = Players.LocalPlayer

	local waypoints = {} -- { {name, position} }

	-- ============ GAME-SPECIFIC: preencha para o jogo alvo ============
	local function getRoot()
		if localPlayer.Character then
			return localPlayer.Character:FindFirstChild("HumanoidRootPart")
		end
		return nil
	end
	local function teleportTo(position)
		local root = getRoot()
		if not root then return false end
		-- FILL: aplicar CFrame ao root (algunos jogos exigem desativar colisoes/anchored)
		pcall(function() root.CFrame = CFrame.new(position) end)
		return true
	end
	local function getPlayerRoot(player)
		if player.Character then return player.Character:FindFirstChild("HumanoidRootPart") end
		return nil
	end
	-- =================================================================

	local section = win:CreateTab("Navigation", 60):CreateSection("Navigation")
	local cWaypointName = section:TextBox({ Name = "Nome do Waypoint", Placeholder = "ex: Base", Flag = "nav_wpname" })
	local cAddWP = section:Button({ Name = "Adicionar Waypoint (aqui)", Flag = "nav_addwp" })
	local cTpPlayer = section:TextBox({ Name = "Teleport p/ Jogador", Placeholder = "nome do jogador", Flag = "nav_tpplayer" })
	local cTpBtn = section:Button({ Name = "Teleportar", Flag = "nav_tpbtn" })
	local cList = section:Label("Waypoints: (nenhum)")

	local ctlList = ui.Controls["nav_wpname"] -- nao usado, apenas referencia

	local addCtrl, tpBtnCtrl = nil, nil
	for flag, ctl in pairs(ui.Controls) do
		if flag == "nav_addwp" then addCtrl = ctl end
		if flag == "nav_tpbtn" then tpBtnCtrl = ctl end
	end

	local function refreshList()
		local txt = "Waypoints: " .. #waypoints
		for _, wp in ipairs(waypoints) do txt = txt .. " | " .. wp.name end
		-- FILL: atualizar texto do label de lista se necessario
	end

	if addCtrl and addCtrl.Row then
		addCtrl:_conn(addCtrl.Row.Activated, function()
			local root = getRoot()
			if not root then return end
			local name = ui:Get("nav_wpname") or ("WP" .. (#waypoints + 1))
			table.insert(waypoints, { name = name, position = root.Position })
			refreshList()
			ui:Notify("Waypoint", "Adicionado: " .. name, "info")
		end)
	end
	if tpBtnCtrl and tpBtnCtrl.Row then
		tpBtnCtrl:_conn(tpBtnCtrl.Row.Activated, function()
			local name = ui:Get("nav_tpplayer")
			if not name or name == "" then return end
			local target = Players:FindFirstChild(name)
			if not target then ui:Notify("Navigation", "Jogador nao encontrado", "error"); return end
			local troot = getPlayerRoot(target)
			if not troot then ui:Notify("Navigation", "Sem raiz do personagem", "error"); return end
			if teleportTo(troot.Position) then
				ui:Notify("Navigation", "Teleportado para " .. name, "info")
			else
				ui:Notify("Navigation", "Falha ao teleportar", "error")
			end
		end)
	end

	local function teleportWaypoint(wp)
		if teleportTo(wp.position) then
			ui:Notify("Waypoint", "Teleportado para " .. wp.name, "info")
		else
			ui:Notify("Waypoint", "Falha ao teleportar", "error")
		end
	end

	-- Lista de botoes dinamicos por waypoint (recriada quando a lista muda)
	local wpButtons = {}
	local function rebuildWPButtons()
		-- FILL: criar botoes um abaixo do outro na secao; omitido para nao duplicar controles
		-- O usuario pode teleportar via comando ou lista separada (Fase polish)
	end

	return { stop = function()
		for _, b in ipairs(wpButtons) do if b.Row then pcall(function() b.Row:Destroy() end) end end
		wpButtons = {}
	end }
end
-- src/modules/hub/AntiAFK.lua  (F-100, parte 2)
-- Simula entrada periodica para evitar kick por inatividade.
-- Nao depende de offset de jogo (usa VirtualInputManager ou movimento virtual),
-- mas a eficacia varia por titulo (detecao de AFK e do lado do servidor).
-- Flags: ui:Get("antiafk_*") / ui:Set("antiafk_*", v). Controles na aba "Anti-AFK".

UI.HubModules.AntiAFK = function(ui, win)
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	local VIM = game:GetService("VirtualInputManager")
	local localPlayer = Players.LocalPlayer

	local section = win:CreateTab("Anti-AFK", 70):CreateSection("Anti-AFK")
	local cEnabled = section:Toggle({ Name = "Enabled", Default = false, Flag = "antiafk_enabled" })
	local cInterval = section:Slider({ Name = "Interval (s)", Min = 10, Max = 300, Default = 60, Flag = "antiafk_interval" })
	local cMethod = section:Dropdown({ Name = "Method", Options = { "Jump", "Move", "Input" }, Default = "Jump", Flag = "antiafk_method" })

	local lastAction = 0
	local conn = RunService.Heartbeat:Connect(function()
		if not ui:Get("antiafk_enabled") then return end
		local now = os.clock()
		if now - lastAction < ui:Get("antiafk_interval") then return end
		local method = ui:Get("antiafk_method")
		local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
		if method == "Jump" and hum then
			pcall(function() hum.Jump = true end)
		elseif method == "Move" then
			-- FILL: aplicar movimento virtual curto ao personagem (jogo especifico)
		elseif method == "Input" then
			-- FILL: enviar entrada virtual via VirtualInputManager (alguns jogos ignoram)
			pcall(function()
				VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
				task.delay(0.1, function() VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end)
			end)
		end
		lastAction = now
	end)

	return { stop = function() if conn then conn:Disconnect() end end }
end

return UI
