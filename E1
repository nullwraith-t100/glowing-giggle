-- Mini-grafico de linha de valores (ex: FPS ao longo do tempo).
-- opts: { Name, Points: {number}, Min?, Max?, Color?, Description? }
-- Metodo: ctl:Push(v) adiciona ponto; ctl:SetPoints({n}) substitui

local function Section_Sparkline(self, opts)
	local ui = self.UI
	local points = opts.Points or {}
	local minV, maxV = opts.Min, opts.Max
	local cor = opts.Color or C.Accent

	local row = self:_row(L.Row + 40, false)
	local label = U.label({
		Text = opts.Name, Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -72, 0, L.Hit), Parent = row,
	})
	self:_hook(label, opts.Description)

	local holder = U.frame({
		BackgroundColor3 = C.Background, AnchorPoint = Vector2.new(1, .5),
		Position = UDim2.new(1, -4, .5, 0), Size = UDim2.fromOffset(64, L.Hit + 40), Parent = row,
	})
	U.corner(holder, 8)
	U.stroke(holder, C.Stroke)

	local ctl
	local bars = {}
	local function render()
		local mn, mx = minV, maxV
		if #points > 0 then
			if not mn then mn = unpack(points)
				for _, v in ipairs(points) do if v < mn then mn = v end end
			if not mx then mx = unpack(points)
				for _, v in ipairs(points) do if v > mx then mx = v end end
		end
		if mn == mx then mx = mn + 1 end
		local n = math.max(#points, #bars)
		for i = 1, n do
			local b = bars[i]
			if not b then
				b = U.frame({ BackgroundColor3 = cor, Size = UDim2.fromScale(1 / n, 1), Parent = holder })
				U.corner(b, 2)
				bars[i] = b
			end
			local v = points[i] or mn
			local r = (v - mn) / (mx - mn)
			b.Size = UDim2.fromScale(1 / n, math.clamp(r, 0, 1))
			b.Position = UDim2.fromScale((i - 1) / n, 1 - math.clamp(r, 0, 1))
		end
		for i = #points + 1, #bars do
			bars[i]:Destroy()
		end
		while #bars > #points do table.remove(bars) end
	end
	local function setter(v)
		if typeof(v) ~= "table" then return nil end
		points = v
		ctl.Points = points
		ui.Flags[ctl.Flag] = points
		render()
		return points
	end

	ctl = self:_register("Sparkline", opts, row, points, setter)
	ctl.Points = points
	ctl.Push = function(v)
		table.insert(points, tonumber(v) or 0)
		if #points > 40 then table.remove(points, 1) end
		ctl.Points = points
		ui.Flags[ctl.Flag] = points
		render()
	end
	render()

	return self
end

