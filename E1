function Section:Slider(opts)
	local min, max, step = opts.Min or 0, opts.Max or 100, opts.Step or 1
	local suffix = opts.Suffix or ""
	local dec = math.max(decimals(step), decimals(min))
	local row = self:_row(L.Hit + 36, false)
	local label = U.label({ Text = opts.Name, Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -92, 0, L.Hit), Parent = row })
	self:_hook(label, opts.Description)
	local box = U.box({
		BackgroundColor3 = C.Background, BackgroundTransparency = 0, Font = F.Medium,
		TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -4, 0, 0), Size = UDim2.fromOffset(84, L.Hit), Parent = row,
	})
	U.corner(box, 8)
	U.stroke(box, C.Stroke)
	local hit = create("Frame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(4, L.Hit), Size = UDim2.new(1, -8, 0, 36), Parent = row,
	})
	local bar = U.frame({
		BackgroundColor3 = C.Stroke, AnchorPoint = Vector2.new(0, .5), Position = UDim2.fromScale(0, .5),
		Size = UDim2.new(1, 0, 0, 6), Parent = hit,
	})
	U.corner(bar, 3)
	local fill = U.frame({ BackgroundColor3 = C.Accent, Size = UDim2.fromScale(0, 1), Parent = bar })
	U.corner(fill, 3)
	local knob = U.frame({
		BackgroundColor3 = C.Knob, AnchorPoint = Vector2.new(.5, .5),
		Position = UDim2.fromScale(0, .5), Size = UDim2.fromOffset(18, 18), Parent = bar,
	})
	U.corner(knob, 9)
	local function snap(v)
		v = math.clamp(v, min, max)
		v = min + math.floor((v - min) / step + .5) * step
		local m = 10 ^ dec
		return math.clamp(math.floor(v * m + .5) / m, min, max)
	end
	local function setter(v)
		v = tonumber(v)
		if not v then return nil end
		v = snap(v)
		local r = max > min and (v - min) / (max - min) or 0
		fill.Size = UDim2.fromScale(r, 1)
		knob.Position = UDim2.fromScale(r, .5)
		box.Text = tostring(v) .. suffix
		return v
	end
	local ctl = self:_register("Slider", opts, row, snap(opts.Default or min), setter)
	self.UI:_bindAccent(function() fill.BackgroundColor3 = C.Accent end)

	ctl:_conn(box.Focused, function() box.Text = tostring(ctl.Value) end)
	ctl:_conn(box.FocusLost, function()
		ctl:Set(tonumber(box.Text:match("-?%d*%.?%d+")) or ctl.Value)
	end)
	local page = self.Tab.Page
	local function fromInput(input)
		local r = (U.pointer(input).X - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X)
		ctl:Set(min + (max - min) * math.clamp(r, 0, 1))
	end
	U.drag(hit, {
		start = function(input)
			page.ScrollingEnabled = false -- evita rolar a página enquanto arrasta
			fromInput(input)
		end,
		move = fromInput,
		stop = function() page.ScrollingEnabled = true end,
	})
	return self
end

