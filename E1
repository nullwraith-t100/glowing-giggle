-- Depende do jogo alvo: getCamera, getCharacters, worldToScreen, raycast e o
-- endereco/offset de entidade sao especificos de cada titulo.
-- Flags: ui:Get("aimbot_*") / ui:Set("aimbot_*", v). Controles na aba "Aimbot".

UI.HubModules.Aimbot = function(ui, win)
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	local UIS = game:GetService("UserInputService")
	local localPlayer = Players.LocalPlayer

	-- ============ GAME-SPECIFIC: preencha para o jogo alvo ============
	local function getCamera() return workspace.CurrentCamera end
	local function getCharacters()
		local out = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				table.insert(out, {
					player = p, character = p.Character,
					root = p.Character.HumanoidRootPart,
					head = p.Character:FindFirstChild("Head"),
					humanoid = hum,
					team = p.Team,
					health = hum and hum.Health or 0,
					maxHealth = hum and hum.MaxHealth or 100,
				})
			end
		end
		return out
	end
	local function worldToScreen(point)
		local cam = getCamera()
		if not cam then return nil end
		local vp, onScreen = cam:WorldToViewportPoint(point)
		return Vector2.new(vp.X, vp.Y), onScreen, vp.Z
	end
	local function raycast(origin, direction, ignoreList)
		local params = RaycastParams.new()
		params.FilterDescendantsInstances = ignoreList or {}
		params.FilterType = Enum.RaycastFilterType.Blacklist
		return workspace:Raycast(origin, direction, params)
	end
	-- ===================================================================

	local section = win:CreateTab("Aimbot", 10):CreateSection("Aimbot")
	local cEnabled = section:Toggle({ Name = "Enabled", Default = false, Flag = "aimbot_enabled" })
	local cKey = section:Keybind({ Name = "Hold Key", Default = Enum.KeyCode.MouseButton2, Flag = "aimbot_key" })
	local cFOV = section:Slider({ Name = "FOV", Min = 10, Max = 500, Default = 120, Flag = "aimbot_fov" })
	local cSmooth = section:Slider({ Name = "Smoothing", Min = 1, Max = 30, Default = 6, Flag = "aimbot_smooth" })
	local cBone = section:Dropdown({ Name = "Bone", Options = { "Head", "UpperTorso", "HumanoidRootPart" }, Default = "Head", Flag = "aimbot_bone" })
	local cTeam = section:Toggle({ Name = "Team Check", Default = true, Flag = "aimbot_team" })
	local cVis = section:Toggle({ Name = "Visibility Check", Default = true, Flag = "aimbot_vis" })
	local cMaxDist = section:Slider({ Name = "Max Distance", Min = 50, Max = 2000, Default = 1000, Flag = "aimbot_maxdist" })

	local function isKeyDown(value)
		if value == "None" then return true end
		local kc = Enum.KeyCode[value]
		if kc then return UIS:IsKeyDown(kc) end
		local mb = Enum.UserInputType[value]
		if mb then return UIS:IsMouseButtonPressed(mb) end
		return false
	end

	local function bonePart(ch)
		local b = ui:Get("aimbot_bone")
		if b == "Head" then return ch.head end
		if b == "UpperTorso" then return ch.character:FindFirstChild("UpperTorso") end
		return ch.root
	end

	local function getTarget()
		local cam = getCamera()
		if not cam then return nil end
		local origin = cam.CFrame.Position
		local fov = ui:Get("aimbot_fov")
		local maxDist = ui:Get("aimbot_maxdist")
		local best, bestScore = nil, fov
		for _, ch in ipairs(getCharacters()) do
			if ui:Get("aimbot_team") and ch.team == localPlayer.Team then continue end
			if (ch.root.Position - origin).Magnitude > maxDist then continue end
			if ui:Get("aimbot_vis") then
				local r = raycast(origin, ch.root.Position - origin, { localPlayer.Character, ch.character })
				if r and r.Instance and not ch.character:IsAncestorOf(r.Instance) then continue end
			end
			local part = bonePart(ch)
			if not part then continue end
			local pos2d, onScreen, depth = worldToScreen(part.Position)
			if not onScreen or depth <= 0 then continue end
			local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
			local dist = (pos2d - center).Magnitude
			if dist < bestScore then
				bestScore = dist
				best = { character = ch, part = part, pos = part.Position }
			end
		end
		return best
	end

	local conn = RunService.RenderStepped:Connect(function()
		if not ui:Get("aimbot_enabled") then return end
		if not isKeyDown(ui:Get("aimbot_key")) then return end
		local target = getTarget()
		if not target then return end
		local cam = getCamera()
		local smooth = math.max(1, ui:Get("aimbot_smooth"))
		local current = cam.CFrame.Position
		local desired = CFrame.lookAt(current, target.pos)
		-- interpolacao linear simplificada da posicao da camera (suavizacao)
		cam.CFrame = CFrame.new(current:Lerp(desired.Position, 1 / smooth)) * (cam.CFrame - cam.CFrame.Position)
	end)

	return { stop = function() if conn then conn:Disconnect() end end }
end
