local UI = (function()
--[[
	DERBYBLOOM UI - UI standalone para Roblox (Luau). Sem loadstring, sem libs, tudo por Instance.new.
	Estrutura: UI.new() -> :CreateWindow() -> :CreateTab() -> :CreateSection() -> controles.
	Controles retornam a Section (encadeável). O último controle criado fica em section.Last.
	Acesso global por flag: ui:Get("Flag"), ui:Set("Flag", valor), ui.Controls["Flag"].

	USO (em qualquer script/jogo):
		local UI = loadstring(readfile("derbybloom_ui.lua"))()          -- ou loadstring(game:HttpGet(url))()
		local ui = UI.new({ Icon = "rbxassetid://..." })           -- Icon opcional (botão de abrir + header)
		local win = ui:CreateWindow({ Title = "Meu Hub", Author = "by eu",
			Icon = "rbxassetid://...", Background = "rbxassetid://...", BackgroundImageTransparency = 0.7 })
		local tab = win:CreateTab("Main", 1)
		tab:CreateSection("Geral"):Toggle({ Name = "X", Callback = function(v) end })
		-- controles: Toggle, Slider, Dropdown, MultiDropdown, Keybind, Button, TextBox, ColorPicker, Label, Divider
	Tema: rosa e branco (CONFIG.Colors). Padrões de Icon/Background em CONFIG; tudo sobrescrevível por opts.
]]

